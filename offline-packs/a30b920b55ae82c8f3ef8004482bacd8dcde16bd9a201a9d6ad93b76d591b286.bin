    { name: 'Juice', emoji: 'üßÉ', ipa: '/d íuÀês/', meaning: 'N∆∞·ªõc √âp Tr√°i C√¢y', sentence: 'I drink juice.', hex: '#FF9800' },
    { name: 'Tea', emoji: 'üçµ', ipa: '/tiÀê/', meaning: 'Tr√†', sentence: 'I drink tea.', hex: '#4CAF50' },
    { name: 'Cookie', emoji: 'üç™', ipa: '/Ààk äki/', meaning: 'B√°nh Quy', sentence: 'I want a cookie.', hex: '#8D6E63' }
