<div class="container">

  <!-- TAB 1: VOCABULARY GRID -->
  <div id="vocab" class="tab-content active">
    <h2 style="margin-bottom: 16px; text-align: center; color: #2F855A; font-weight: 800; font-size: 1.4rem;">T·ª´ V·ª±ng Lo·∫°i Tr√°i C√¢y</h2>
