        <path d="M 28 35 L 10 50 L 22 62 L 28 54 L 25 88 L 75 88 L 72 54 L 78 62 L 90 50 L 72 35 Z" fill="#FFEB3B" stroke="#FBC02D" stroke-width="2.5"/>
