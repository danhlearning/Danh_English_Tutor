<script>
  document.addEventListener('DOMContentLoaded', () => {
    const update = DanhSchoolSuppliesMigration(window.DanhLearners.storage, schoolSupplies.map(word => word.name.toLowerCase()));
    if (update.changed) {
      const note = document.createElement('p');
      note.className = 'school-vocab-note';
      note.textContent = 'B√†i ƒë√£ r√∫t g·ªçn c√≤n 18 t·ª´. C√°c t·ª´ em ch·ªçn c√≤n ph√π h·ª£p ƒë√£ ƒë∆∞·ª£c gi·ªØ; l∆∞·ª£t c√≥ t·ª´ ƒë√£ b·ªè s·∫Ω b·∫Øt ƒë·∫ßu l·∫°i. K·∫øt qu·∫£ c≈© ƒë√£ ƒë∆∞·ª£c l∆∞u ri√™ng trong h·ªì s∆°.';
      document.getElementById('vocab').prepend(note);
    }
    DanhLesson.mount({
    topic: 'schoolsupplies',
    words: schoolSupplies.map((word, index) => ({
      id: word.name.toLowerCase(), name: word.name, meaning: word.meaning,
      ipa: word.ipa, color: word.hex, visual: word.emoji
    }))
  });
  });
</script>

