  window.DanhPencil?.apply('fooddrinks', foodVocabulary);


  /* D·ªÆ LI·ªÜU C√ÇU H·ªéI GAME 4: NG·ªÆ PH√ÅP C·ª∞C K·ª≤ ƒê∆†N GI·∫¢N C·∫§P TI·ªÇU H·ªåC */
  const sentenceQuestions = [
    { emoji: 'üçï', vietnamese: 'T√¥i th√≠ch b√°nh pizza.', hint: 'T√¥i + th√≠ch + [M√≥n ƒÉn]', answer: 'I like pizza' },
