    { name: 'Mother', emoji: 'üë©', ipa: '/Ààm å√∞…ôr/', meaning: 'M·∫π', sentence: 'This is my mother.', hex: '#FF6B6B' },
    { name: 'Brother', emoji: 'üë¶', ipa: '/Ààbr å√∞…ôr/', meaning: 'Anh / Em trai', sentence: 'He is my brother.', hex: '#4ECDC4' },
    { name: 'Sister', emoji: 'üëß', ipa: '/Ààs…™st…ôr/', meaning: 'Ch·ªã / Em g√°i', sentence: 'She is my sister.', hex: '#FD79A8' },
    { name: 'Grandfather', emoji: 'üë¥', ipa: '/Àà…°r√¶n.f…ëÀê.√∞…ôr/', meaning: '√îng', sentence: 'He is my grandfather.', hex: '#00B894' },
    { name: 'Grandmother', emoji: 'üëµ', ipa: '/Àà…°r√¶n.m å√∞…ôr/', meaning: 'B√†', sentence: 'She is my grandmother.', hex: '#6C5CE7' },
    { name: 'Baby', emoji: 'üë∂', ipa: '/Ààbe…™bi/', meaning: 'Em b√©', sentence: 'Look at the baby.', hex: '#FFE66D' },
    { name: 'Parents', emoji: 'üë®‚Äçüë©‚Äçüë¶', ipa: '/Ààpe…ôr…ônts/', meaning: 'B·ªë m·∫π', sentence: 'I love my parents.', hex: '#E17055' },
    { name: 'Friend', emoji: 'üßë‚Äçü§ù‚Äçüßë', ipa: '/frend/', meaning: 'B·∫°n b√®', sentence: 'He is my friend.', hex: '#00CEC9' },
    { name: 'Best friend', emoji: 'üë´', ipa: '/best frend/', meaning: 'B·∫°n th√¢n', sentence: 'She is my best friend.', hex: '#FF7675' },
    { name: 'Uncle', emoji: 'üßî', ipa: '/Àà å≈ãkl/', meaning: 'Ch√∫ / B√°c / C·∫≠u', sentence: 'He is my uncle.', hex: '#0984E3' },
