    align-items: center;
    margin-top: 8px;
    transition: transform 0.2s;
  }

  .audio-btn:hover { transform: scale(1.1); }

  /* MáºªU CÃ‚U */
  .sentence-section { display: flex; flex-direction: column; gap: 16px; }
  .sentence-card { background: #F3E5F5; border-left: 5px solid var(--primary); padding: 16px; border-radius: 10px; }
  .sentence-card h3 { color: #8E24AA; margin-bottom: 8px; font-weight: 800; font-size: 1.1rem; }
  .dialogue { background: white; padding: 12px; border-radius: 8px; margin-top: 8px; }
  .speaker { font-weight: 800; color: #AB47BC; }

  /* GAMES */
  .single-card-container, .quiz-container, .spelling-box, .count-game-container {
    display: flex;
    flex-direction: column;
