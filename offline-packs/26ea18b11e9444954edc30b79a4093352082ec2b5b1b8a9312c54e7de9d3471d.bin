  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Nunito', sans-serif; }

  body {
    background-color: var(--bg-color);
    background-image: radial-gradient(#AB47BC 0.75px, transparent 0.75px), radial-gradient(#EC407A 0.75px, #FCE4EC 0.75px);
