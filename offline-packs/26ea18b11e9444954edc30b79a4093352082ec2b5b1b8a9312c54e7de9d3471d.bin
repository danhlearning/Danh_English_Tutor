  }

  .audio-btn {
    background: white;
    color: #2D3748;
    border: none;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: 0 3px 6px rgba(0,0,0,0.15);
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
    transition: transform 0.2s;
  }

  .audio-btn:hover {
    transform: scale(1.1);
  }

  /* TAB 2: RULES */
  .sentence-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sentence-card {
    background: #F7FAFC;
    border-left: 5px solid var(--primary);
