  }

  .number-display {
    font-size: 3.2rem;
    line-height: 1;
  }

  .word-title {
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 2px;
  }

  .phonetic {
    font-size: 0.9rem;
    opacity: 0.95;
