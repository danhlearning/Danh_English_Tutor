(() => {
  'use strict';
  const id = document.body.dataset.unit;
  const unit = window.DanhGrade12Units.find(item => item.id === id);
  if (!unit) return;
  const $ = selector => document.querySelector(selector);
  document.title = `Unit ${unit.number} Â· ${unit.title} Â· Tiáº¿ng Anh lá»›p 12`;
  $('#unit-number').textContent = `UNIT ${String(unit.number).padStart(2, '0')} Â· GLOBAL SUCCESS`;
  $('#unit-title').textContent = unit.title;
  $('#unit-meaning').textContent = unit.vietnamese;
  $('#unit-icon').textContent = unit.icon;
  document.documentElement.style.setProperty('--unit-color', unit.color);
  const key = `danh-g12-${id}`;
  let learned = [];
  try {
    const saved = JSON.parse(window.DanhLearners.storage.getItem(key) || '[]');
    if (Array.isArray(saved)) learned = saved.filter(value => Number.isInteger(value) && value >= 1 && value <= unit.words.length);
  } catch { /* Trang váº«n dÃ¹ng Ä‘Æ°á»£c khi trÃ¬nh duyá»‡t cháº·n lÆ°u trá»¯. */ }
  const mastered = new Set(learned);
  const updateProgress = () => { const progress = $('#unit-progress'); progress.textContent = mastered.size ? 'ÄÃ£ luyá»‡n táº­p' : ''; progress.hidden = !progress.textContent; };
  const mark = word => {
    mastered.add(word.id); updateProgress();
    try { window.DanhLearners.storage.setItem(key, JSON.stringify([...mastered])); } catch { /* KhÃ´ng lÆ°u Ä‘Æ°á»£c trÃªn thiáº¿t bá»‹ nÃ y. */ }
  };
  const speak = term => {
    if(window.DanhListenControls?.isManualRequest())return window.DanhAnswerSpeech.listen(term);
    const status = $('#speech-note');
    if (!window.DanhVocabularyGame.soundEnabled()) { status.textContent = 'Ã‚m thanh Ä‘ang táº¯t.'; return; }
    window.DanhAnswerSpeech.say(term);
    status.textContent = `Äang Ä‘á»c: ${term}`;
  };
  const button = (label, callback, className = '') => {
    const element = document.createElement('button'); element.type = 'button'; element.className = className;
    element.textContent = label; element.addEventListener('click', callback); return element;
  };
  const illustration = (word, className) => {
    const frame = document.createElement('span');
    frame.className = className === 'g6-word-icon' ? 'g6-word-visual' : 'g6-flash-visual';
    if (word.image) {
      const image = document.createElement('img');
      image.className = className; image.src = word.image;
      image.alt = `Minh há»a: ${word.meaning}`;
      image.width = 768; image.height = 768; image.loading = 'lazy';
      image.addEventListener('error', () => {
        image.remove();
        const fallback = document.createElement('span');
        fallback.className = `${className} g6-symbol-art`;
        fallback.textContent = word.icon; fallback.setAttribute('aria-hidden', 'true');
        frame.append(fallback);
      }, {once:true});
      frame.append(image); return frame;
    }
    const icon = document.createElement('span'); icon.className = `${className} g6-symbol-art`;
    icon.textContent = word.icon; icon.classList.toggle('g6-composite-symbol', word.icon.includes('\u200d'));
    icon.setAttribute('aria-hidden', 'true'); frame.append(icon); return frame;
  };
  const vocab = $('#vocab-grid');
  for (const word of unit.words) {
    const card = document.createElement('article'); card.className = 'g6-word-card';
    const icon = illustration(word, 'g6-word-icon');
    const title = document.createElement('h3'); title.textContent = word.term;
    const meaning = document.createElement('p'); meaning.className = 'g6-meaning'; meaning.textContent = word.meaning;
    const example = document.createElement('p'); example.className = 'g6-example'; example.textContent = word.example;
    card.append(icon, title, meaning, example, button('ğŸ”Š Nghe tá»«', () => speak(word.term), 'g6-sound'));
    vocab.append(card);
  }
  const tabs = [...document.querySelectorAll('[data-tab]')];
  const tabKey = `danh-g12-${id}-tab-v1`;
  function showTab(name) {
    window.DanhAnswerSpeech?.stop();
    try { window.DanhLearners.storage.setItem(tabKey,name); } catch {}

    for (const tab of tabs) {
      const active = tab.dataset.tab === name;
      tab.classList.toggle('active', active); tab.setAttribute('aria-selected', String(active));
      document.getElementById(tab.dataset.tab).hidden = !active;
    }
  }
  for (const tab of tabs) tab.addEventListener('click', () => { showTab(tab.dataset.tab); window.DanhVocabularyGame.feedback('tap',tab); });
  let initialTab='vocabulary';
  try { const saved=window.DanhLearners.storage.getItem(tabKey); if(tabs.some(t=>t.dataset.tab===saved))initialTab=saved; } catch {}
  const requestedTab=new URLSearchParams(location.search).get('activity');
  if(tabs.some(t=>t.dataset.tab===requestedTab))initialTab=requestedTab;
  showTab(initialTab);
  updateProgress();

  const cards = window.DanhVocabularyGame.flashcards({
    card: $('#flashcard'), words: unit.words, previous: $('#flash-prev'), next: $('#flash-next'),
    illustration: word => illustration(word, 'g6-flash-icon')
  });
  $('#flash-sound').addEventListener('click', () => speak(cards.current().term));

  window.DanhVocabularyGame.mount({
    stage: $('#quiz-stage'), words: unit.words.map(word => ({...word,unit:unit.number})),
    grade: 12, scope: id, mark
  });

  window.DanhGrade12Spelling({stage:$('#spelling-stage'),words:unit.words,unitId:id});
})();
/* GÃµ tá»« lá»›p 12: lÆ°á»£t riÃªng theo Unit/há»“ sÆ¡, giá»¯ báº±ng chá»©ng tá»± sá»­a vÃ  Ä‘Ã£ xem. */
'use strict';
window.DanhGrade12Spelling = function ({stage, words, unitId}) {
  const key = `danh-g12-spelling-${unitId}-v1`;
  const storage = window.DanhLearners.storage;
  const byId = new Map(words.map(w => [w.id, w]));
  const normal = value => String(value).trim().toLocaleLowerCase('en').replace(/[â€™â€˜]/g,"'").replace(/\s+/g,' ');
  const outcomes = ['first','corrected','hinted','seen'];
  let warning = '', state;
  function fresh(ids = words.map(w => w.id)) {
    return {version:1, order:window.DanhVocabularyGame.shuffle(ids), position:0, entries:{}};
  }
  function valid(s) {
    return s?.version === 1 && Array.isArray(s.order) && s.order.length > 0 && s.order.length <= words.length &&
      new Set(s.order).size === s.order.length && s.order.every(id => byId.has(id)) &&
      Number.isInteger(s.position) && s.position >= 0 && s.position <= s.order.length && s.entries &&
      s.order.every((id,i) => {
        const e=s.entries[id];
        return (!e ? i >= s.position : typeof e.draft === 'string' && e.draft.length <= 250 && Number.isInteger(e.attempts) && e.attempts >= 0 &&
          (!e.outcome || outcomes.includes(e.outcome)) && (i >= s.position || !!e.outcome));
      });
  }
  try { const saved=JSON.parse(storage.getItem(key)||'null'); state=valid(saved)?saved:fresh(); }
  catch { state=fresh(); }
  function save() {
    try { storage.setItem(key,JSON.stringify(state)); }
    catch { warning='LÆ°á»£t nÃ y chá»‰ Ä‘Æ°á»£c giá»¯ khi trang cÃ²n má»Ÿ.'; }
  }
  const el = (tag,text,cls) => {const e=document.createElement(tag); if(text)e.textContent=text;if(cls)e.className=cls;return e;};
  const button = (label,run,cls='g6-secondary') => {const b=el('button',label,cls);b.type='button';b.addEventListener('click',run);return b;};
  const effect = name => window.DanhVocabularyGame.feedback(name,stage);
  function start(ids) {state=fresh(ids);save();render();effect('start');}
  function render(focus=false) {
    stage.replaceChildren();
    if (state.position >= state.order.length) {
      const values=state.order.map(id=>state.entries[id]);
      stage.append(el('h3','HoÃ n thÃ nh lÆ°á»£t gÃµ tá»«!'),el('p',`ÄÃºng ngay: ${values.filter(e=>e.outcome==='first').length} Â· Tá»± sá»­a: ${values.filter(e=>e.outcome==='corrected').length} Â· CÃ³ gá»£i Ã½: ${values.filter(e=>e.outcome==='hinted').length} Â· ÄÃ£ xem: ${values.filter(e=>e.outcome==='seen').length}`,'g12-result-counts'));
      const weak=state.order.filter(id=>state.entries[id].outcome!=='first');
      if(weak.length){
        const list=el('ul',null,'g12-review-list');
        for(const id of weak){const w=byId.get(id),li=el('li');li.append(el('span',`${w.term} Â· ${w.meaning}`),button('ğŸ”Š Nghe',()=>window.DanhAnswerSpeech.say(w.term),'g6-sound'));list.append(li);}
        stage.append(list,button(`Ã”n ${weak.length} tá»« cÃ²n khÃ³`,()=>start(weak),'g6-primary'));
      }
      stage.append(button('ChÆ¡i lÆ°á»£t má»›i',()=>start()));
      if(focus){stage.querySelector('h3').tabIndex=-1;stage.querySelector('h3').focus();}
      return;
    }
    const id=state.order[state.position],w=byId.get(id);
    window.DanhGameFlow?.prepare(state.order.slice(state.position,state.position+3).map(id=>byId.get(id)),stage);
    const entry=state.entries[id] ||= {draft:'',attempts:0,outcome:null};
    save();
    const position=el('p',`Tá»« ${state.position+1}/${state.order.length}`,'g6-card-position');
    const heading=el('h3',w.meaning);heading.id='spelling-question';
    const form=el('form',null,'g6-answer');
    const input=el('input'); input.type='text';input.maxLength=250;input.autocomplete='off';input.spellcheck=false;input.autocapitalize='none';input.setAttribute('aria-labelledby',heading.id);input.value=entry.draft;
    const submit=el('button','Kiá»ƒm tra','g6-primary');submit.type='submit';
    const feedback=el('p',null,'g6-feedback');feedback.setAttribute('role','status');input.setAttribute('aria-describedby','spelling-feedback');feedback.id='spelling-feedback';
    const actions=el('div',null,'g12-spelling-actions');
    const listen=button('ğŸ”Š Nghe gá»£i Ã½',()=>{
      if(!window.DanhListenControls?.isManualRequest() && !window.DanhVocabularyGame.soundEnabled()){feedback.textContent='Ã‚m thanh Ä‘ang táº¯t.';return;}
      if(!entry.outcome){entry.hint=true;save();}
      window.DanhAnswerSpeech.say(w.term);
    },'g6-sound');
    const reveal=button('Xem Ä‘Ã¡p Ã¡n',()=>{
      if(entry.outcome)return;entry.outcome='seen';save();effect('help');showResult();next.focus();
    });
    const next=button('Tá»« tiáº¿p theo â†’',()=>{
      if(!entry.outcome||next.disabled)return;
      next.disabled=true;state.position++;save();render(true);effect(state.position===state.order.length?'complete':'next');
    },'g6-primary');
    function showResult() {
      const done=!!entry.outcome;
      input.disabled=done;submit.disabled=done;
      reveal.hidden=done||entry.attempts<2;next.hidden=!done;
      listen.textContent=done?'ğŸ”Š Nghe láº¡i':'ğŸ”Š Nghe gá»£i Ã½';
      if(done)feedback.textContent=entry.outcome==='seen'?`ÄÃ¡p Ã¡n: ${w.term}. CÃ¹ng Ã´n láº¡i tá»« nÃ y nhÃ©.`:entry.outcome==='corrected'?`Em Ä‘Ã£ tá»± sá»­a Ä‘Ãºng: ${w.term}!`:entry.outcome==='hinted'?`ÄÃºng vá»›i gá»£i Ã½: ${w.term}!`:`ÄÃºng rá»“i: ${w.term}!`;
      else if(entry.attempts)feedback.textContent='ChÆ°a khá»›p. Em thá»­ láº¡i hoáº·c nghe gá»£i Ã½ nhÃ©.';
    }
    input.addEventListener('input',()=>{entry.draft=input.value;save();});
    form.addEventListener('submit',event=>{
      event.preventDefault();if(entry.outcome)return;
      if(!input.value.trim()){feedback.textContent='GÃµ tá»« trÆ°á»›c nhÃ©.';input.focus();return;}
      entry.draft=input.value;
      if(normal(input.value)===normal(w.term)){
        entry.outcome=entry.hint?'hinted':entry.attempts?'corrected':'first';save();effect(entry.outcome==='first'?'good':'corrected');showResult();window.DanhAnswerSpeech.say(w.term);next.focus();
      }else{entry.attempts++;save();effect('bad');showResult();input.setAttribute('aria-invalid','true');input.focus();input.select();}
    });
    input.addEventListener('input',()=>input.removeAttribute('aria-invalid'));
    form.append(input,submit);actions.append(listen,reveal,next);
    stage.append(position,heading,form,actions,feedback);
    if(warning)stage.append(el('p',warning,'g6-note'));
    showResult();
    if(focus&&!entry.outcome)input.focus();
  }
  save();
  render();
};
