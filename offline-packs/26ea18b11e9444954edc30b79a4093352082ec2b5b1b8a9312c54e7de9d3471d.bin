    border-radius: 12px;
    margin-bottom: 10px;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.05), 0 4px 8px rgba(0,0,0,0.12);
    background: #FFFFFF;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding: 6px;
  }

  .svg-icon { width: 100px; height: 100px; }

  .word-title { font-size: 1.4rem; font-weight: 800; margin-bottom: 2px; }
  .phonetic { font-size: 0.95rem; opacity: 0.95; margin-bottom: 4px; font-weight: 600; }
  .meaning { font-size: 0.9rem; background: rgba(0, 0, 0, 0.25); padding: 2px 10px; border-radius: 10px; margin-bottom: 10px; font-weight: 700; }

  .example-box {
    background: rgba(255, 255, 255, 0.95);
    color: #4A148C;
    padding: 8px 12px;
    border-radius: 8px;
    width: 100%;
    font-size: 0.85rem;
    text-align: left;
  }

  .audio-btn {
    background: white;
    color: #4A148C;
    border: none;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: 0 3px 6px rgba(0,0,0,0.15);
    display: flex;
