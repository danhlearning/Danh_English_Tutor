        { ipa: "/kÉ™ÊŠp/", word: "cope", meaning: "Ä‘Æ°Æ¡ng Ä‘áº§u, Ä‘á»‘i phÃ³" },
        { ipa: "/ËˆkÉ”ËpÉ™rÉ™t/", word: "corporate", meaning: "thuá»™c vá» doanh nghiá»‡p, táº­p Ä‘oÃ n" },
        { ipa: "/ËˆkredÉ™bl/", word: "credible", meaning: "Ä‘Ã¡ng tin cáº­y, cÃ³ uy tÃ­n" }
    ];

    // Tráº¡ng thÃ¡i á»©ng dá»¥ng
    let currentData = [];
    let currentQuestionIndex = 0;
    let correctCount = 0;
    let incorrectCount = 0;
    let autoNextTimeout;
    let roundGeneration=0;
    let timeLeft = 600; // 10 phÃºt = 600 giÃ¢y
    let timerInterval;
    let currentLevel='basic';
    let gameFinished=false;
    const ipaKey='danh:ipa-reflex:v1';
    function saveReflexResult(reason) {
        if(window.DanhLearners && !window.DanhLearners.current) return;
        try {
            const storage=window.DanhLearners?.storage || window.localStorage;
            let history=JSON.parse(storage.getItem(ipaKey) || '[]');
            if(!Array.isArray(history))history=[];
            history.push({level:currentLevel,correct:correctCount,incorrect:incorrectCount,total:currentData.length,reason,at:Date.now()});
            storage.setItem(ipaKey,JSON.stringify(history.slice(-100)));
        } catch {}
    }

    // HÃ m trá»™n máº£ng (Fisher-Yates Shuffle)
    function shuffleArray(array) {
        let shuffled = [...array];
        for (let i = shuffled.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        return shuffled;
    }

    function startTimer() {
        clearInterval(timerInterval);
        timeLeft = 600;
        updateTimerDisplay();
        
        timerInterval = setInterval(() => {
            if(document.hidden || (window.DanhLearners && !window.DanhLearners.current))return;
            timeLeft--;
            updateTimerDisplay();
            
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                endGameByTime();
            }
        }, 1000);
    }

    function updateTimerDisplay() {
        let minutes = Math.floor(timeLeft / 60);
        let seconds = timeLeft % 60;
        document.getElementById("timer-display").innerText = `â±ï¸ ${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    }

    function endGameByTime() {
        if(gameFinished)return;
        gameFinished=true;
        saveReflexResult('time');
        document.getElementById("ipa-display").innerText = "â°";
        document.getElementById("ipa-container").style.border = "none";
        document.getElementById("ipa-container").style.background = "transparent";
        
        document.getElementById("input-area").style.display = "none";
        document.getElementById("progress").innerText = "Háº¿t giá»!";
        
        const explanationEl = document.getElementById("explanation");
        explanationEl.innerHTML = `
            <div style="text-align: center; font-size: 1.2rem;">
                <strong style="color: #dc2626; font-size: 1.5rem;">â° ÄÃƒ Háº¾T 10 PHÃšT!</strong><br><br>
                Thá»­ thÃ¡ch káº¿t thÃºc. Trong 10 phÃºt, báº¡n gÃµ Ä‘Æ°á»£c:<br>
                <strong style="color: #15803d; font-size: 1.5rem;">ÄÃºng: ${correctCount}</strong> cÃ¢u. | 
                <strong style="color: #b91c1c; font-size: 1.5rem;">Sai: ${incorrectCount}</strong> cÃ¢u.
            </div>
        `;
        explanationEl.style.display = "block";
        
        resetUI();
        document.getElementById("check-btn").style.display = "none";
        document.getElementById("feedback").style.display = "none";
    }

    // Chá»n cáº¥p Ä‘á»™ (Tab)
    function setLevel(level) {
        roundGeneration++;clearTimeout(autoNextTimeout);window.DanhAnswerSpeech?.stop();
        currentLevel=level;
        gameFinished=false;
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-${level}`).classList.add('active');

        if (level === 'basic') {
            currentData = shuffleArray(basicWords);
        } else if (level === 'intermediate') {
            currentData = shuffleArray(intermediateWords);
        } else if (level === 'toeic') {
            currentData = shuffleArray(toeicWords);
        }

        // Reset tráº¡ng thÃ¡i
        currentQuestionIndex = 0;
        correctCount = 0;
        incorrectCount = 0;
        document.getElementById("correct-display").innerText = `ÄÃºng: 0`;
        document.getElementById("incorrect-display").innerText = `Sai: 0`;

        document.getElementById("ipa-container").style.border = "2px dashed #f0abfc";
        document.getElementById("ipa-container").style.background = "#fdf4ff";
        document.getElementById("input-area").style.display = "flex";

        startTimer();
        loadQuestion();
    }

    function loadQuestion() {
        if (autoNextTimeout) clearTimeout(autoNextTimeout);

        const currentQ = currentData[currentQuestionIndex];
        document.getElementById("progress").innerText = `Tá»«: ${currentQuestionIndex + 1}/${currentData.length}`;
        document.getElementById("ipa-display").innerText = currentQ.ipa;
        resetUI();
    }

    function checkAnswer() {
        if(gameFinished || document.getElementById('answer-input').disabled)return;
        const userAnswer = document.getElementById("answer-input").value.trim().toLowerCase();
        const currentQ = currentData[currentQuestionIndex];
        const correctAnswers = currentQ.word.toLowerCase().split("/").map(item => item.trim());
        
        const feedbackEl = document.getElementById("feedback");
        const explanationEl = document.getElementById("explanation");
        const nextBtn = document.getElementById("next-btn");
        const checkBtn = document.getElementById("check-btn");

        if (userAnswer === "") {
            alert("Vui lÃ²ng nháº­p tá»« tiáº¿ng Anh cá»§a báº¡n!");
            return;
        }

        explanationEl.innerHTML = `Tá»« Ä‘Ãºng: <strong>${currentQ.word}</strong> <br> <span class="meaning">NghÄ©a lÃ : ${currentQ.meaning}</span>`;
        explanationEl.style.display = "block";
        checkBtn.style.display = "none";
        document.getElementById("answer-input").disabled = true;

        if (correctAnswers.includes(userAnswer)) {
            const speechFinished=window.DanhAnswerSpeech.say(userAnswer);
            correctCount++;
            document.getElementById("correct-display").innerText = `ÄÃºng: ${correctCount}`;
            
            feedbackEl.innerHTML = `âœ… ChÃ­nh xÃ¡c! <span class="auto-next-msg">Nghe xong sáº½ chuyá»ƒn tá»« tiáº¿p theo...</span>`;
            feedbackEl.className = "feedback correct";
            nextBtn.style.display = "none";

            const answeredIndex=currentQuestionIndex;
            const answeredGeneration=roundGeneration;
            Promise.resolve(speechFinished).then(()=>{
                if(gameFinished||document.hidden||roundGeneration!==answeredGeneration||currentQuestionIndex!==answeredIndex)return;
                autoNextTimeout=setTimeout(()=>{if(!gameFinished&&!document.hidden&&roundGeneration===answeredGeneration&&currentQuestionIndex===answeredIndex)nextQuestion();},1000);
            });

        } else {
            incorrectCount++;
            document.getElementById("incorrect-display").innerText = `Sai: ${incorrectCount}`;
            
            const displayAnswer = correctAnswers[0];
            feedbackEl.innerText = `âŒ Sai rá»“i! ÄÃ¡p Ã¡n Ä‘Ãºng lÃ : ${displayAnswer}`;
            feedbackEl.className = "feedback incorrect";
            nextBtn.style.display = "block"; 
        }
    }

    function nextQuestion() {
        if(gameFinished)return;
        if(autoNextTimeout)clearTimeout(autoNextTimeout);
        currentQuestionIndex++;
        if (currentQuestionIndex < currentData.length) {
            loadQuestion();
        } else {
            gameFinished=true;
            saveReflexResult('complete');
            clearInterval(timerInterval);
            document.getElementById("ipa-display").innerText = "ðŸŽ‰";
            document.getElementById("ipa-container").style.border = "none";
            document.getElementById("ipa-container").style.background = "transparent";
            
            document.getElementById("input-area").style.display = "none";
            document.getElementById("progress").innerText = "HoÃ n thÃ nh!";
            
            const explanationEl = document.getElementById("explanation");
            explanationEl.innerHTML = `
                <div style="text-align: center; font-size: 1.2rem;">
                    <strong>ChÃºc má»«ng! Báº¡n Ä‘Ã£ hoÃ n thÃ nh toÃ n bá»™ nhÃ³m tá»« nÃ y!</strong><br><br>
                    Káº¿t quáº£ cá»§a báº¡n: <strong style="color: #15803d;">ÄÃºng: ${correctCount}</strong> - <strong style="color: #b91c1c;">Sai: ${incorrectCount}</strong> trong lÆ°á»£t luyá»‡n nÃ y.
                </div>
            `;
            explanationEl.style.display = "block";
            
            resetUI();
            document.getElementById("check-btn").style.display = "none";
            document.getElementById("feedback").style.display = "none";
        }
    }

    function resetUI() {
        const inputEl = document.getElementById("answer-input");
        if(inputEl) {
            inputEl.value = "";
            inputEl.disabled = false;
            inputEl.focus();
        }
        
        document.getElementById("feedback").innerText = "";
        document.getElementById("explanation").style.display = "none";
        document.getElementById("next-btn").style.display = "none";
        
        const checkBtn = document.getElementById("check-btn");
        if(checkBtn && currentQuestionIndex < currentData.length) {
            checkBtn.style.display = "block";
        }
    }

    window.onload = () => {
        setLevel('basic');
        startTimer();
    };

    document.getElementById("answer-input").addEventListener("keypress", function(event) {
        if (event.key === "Enter") {
            if (document.getElementById("check-btn").style.display !== "none") {
                checkAnswer();
            } else if (document.getElementById("next-btn").style.display !== "none") {
                nextQuestion();
            }
        }
    });
function speakWord(word) {
    if(window.DanhListenControls?.isManualRequest())return window.DanhAnswerSpeech.listen(word);
        if ('speechSynthesis' in window) {
            // Há»§y cÃ¡c giá»ng Ä‘á»c cÅ© Ä‘á»ƒ trÃ¡nh Ä‘Ã¨ Ã¢m thanh
            window.speechSynthesis.cancel();

            const utterance = new SpeechSynthesisUtterance(word);

            // Thiáº¿t láº­p ngÃ´n ngá»¯ tiáº¿ng Anh vÃ  tá»‘c Ä‘á»™ Ä‘á»c tháº­t cháº­m
            utterance.lang = 'en-US';
            utterance.rate = 0.6;

            // Ã‰p trÃ¬nh duyá»‡t tÃ¬m giá»ng chuáº©n tiáº¿ng Anh
            const voices = window.speechSynthesis.getVoices();
            const englishVoice = voices.find(voice => voice.lang.includes('en-') && (voice.name.includes('Google') || voice.name.includes('Natural') || voice.name.includes('Samantha') || voice.name.includes('Daniel')));

            if (englishVoice) {
                utterance.voice = englishVoice;
            }

            window.speechSynthesis.speak(utterance);
        } else {
            alert('TrÃ¬nh duyá»‡t cá»§a báº¡n khÃ´ng há»— trá»£ tÃ­nh nÄƒng phÃ¡t Ã¢m.');
