        /* Styling for Tables */
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 1.1rem; }
        th, td { border: 1px solid #cbd5e1; padding: 15px; text-align: left; vertical-align: top; }
        th { background-color: var(--primary); color: white; font-weight: 700; width: 25%; text-align: center; }
        td:nth-child(1) { font-weight: bold; color: #b91c1c; text-align: center; }
        tr:nth-child(even) { background-color: #f1f5f9; }

        /* Styling for Examples */
        .example-box {
            background-color: var(--accent); border-left: 5px solid var(--primary);
            padding: 15px 20px; border-radius: 4px; margin-bottom: 20px;
        }
        .example-box p { margin-bottom: 8px; }
        .example-box p:last-child { margin-bottom: 0; }

        .highlight { font-weight: 700; color: #b91c1c; }
        .meaning { font-style: italic; color: #475569; font-size: 1rem; }

        .btn-back {
            display: inline-block; background-color: var(--text-muted); color: white;
            padding: 10px 20px; border-radius: 50px; text-decoration: none;
            font-weight: 700; margin-bottom: 20px; transition: background 0.3s;
        }
        .btn-back:hover { background-color: #475569; }

        .btn-practice {
            display: block; text-align: center; background-color: var(--primary);
            color: white; padding: 15px 30px; border-radius: 50px;
            text-decoration: none; font-weight: 700; font-size: 1.2rem;
            margin-top: 40px; transition: background 0.3s;
        }
        .btn-practice:hover { background-color: var(--primary-hover); }

        @media (max-width: 768px) {
            .container { padding: 20px; }
            th, td { display: block; width: 100% !important; text-align: left !important; }
            th { text-align: center !important; }
        }

        /* --- Contact Section --- */
        .contact-section {
            text-align: center; padding: 40px 20px;
            background: white; border-top: 1px solid #e2e8f0;
            margin: 0 -20px;
        }
        .contact-section h2 { font-size: 1.8rem; margin-bottom: 20px; color: var(--text-main); font-weight: 800; border-bottom: none; }
        .social-buttons { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }
        .btn-social {
            display: flex; align-items: center; gap: 10px; padding: 10px 25px;
            border-radius: 50px; font-size: 1.1rem; font-weight: 700;
            text-decoration: none; background-color: white; transition: all 0.3s ease;
        }
        .btn-zalo { color: var(--zalo-color); border: 2px solid var(--zalo-color); }
        .btn-zalo:hover { background-color: var(--zalo-color); color: white; transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0, 104, 255, 0.3); }
        .zalo-logo { width: 24px; height: 24px; border-radius: 6px; }

        .btn-fb { color: var(--fb-color); border: 2px solid var(--fb-color); }
        .btn-fb:hover { background-color: var(--fb-color); color: white; transform: translateY(-3px); box-shadow: 0 5px 15px rgba(24, 119, 242, 0.3); }
        .fb-icon { width: 22px; height: 22px; fill: var(--fb-color); transition: fill 0.3s; }
        .btn-fb:hover .fb-icon { fill: white; }

        footer { text-align: center; padding: 15px; background: var(--text-main); color: white; font-size: 0.95rem; font-weight: 600; margin: 0 -20px; }
.skills-return{display:inline-flex;align-items:center;min-height:44px;max-width:100%;padding:8px 14px;margin-bottom:16px;border:1px solid var(--pencil);border-radius:14px 17px 13px 16px;background:var(--paper);color:var(--ink);font:inherit;font-weight:800;line-height:1.4;text-decoration:none}
.skills-return:hover{background:#f3ead7}
.skills-return:focus-visible{outline:3px solid var(--green);outline-offset:3px}
