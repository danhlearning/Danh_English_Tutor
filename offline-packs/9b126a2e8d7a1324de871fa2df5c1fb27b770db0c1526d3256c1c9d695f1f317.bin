  const typeNames={choice:'Chá»n Ä‘Ã¡p Ã¡n',fill:'Äiá»n tá»«',order:'Xáº¿p cÃ¢u',correct:'Sá»­a lá»—i',rewrite:'Viáº¿t láº¡i cÃ¢u'};
