          prompt: type === 'rewrite' ? seed.source : type === 'correct' ? bad : type === 'order' ? '' : blank,
          instruction: type === 'rewrite' ? `Viáº¿t láº¡i cÃ¢u cÃ¹ng nghÄ©a, dÃ¹ng â€œ${seed.word}â€.` : type === 'correct' ? 'Sá»­a má»™t lá»—i ngá»¯ phÃ¡p vÃ  viáº¿t láº¡i toÃ n bá»™ cÃ¢u.' : type === 'order' ? 'Sáº¯p xáº¿p cÃ¡c tá»« thÃ nh cÃ¢u Ä‘Ãºng. Báº¥m má»™t tá»« Ä‘Ã£ chá»n Ä‘á»ƒ tráº£ láº¡i.' : type === 'choice' ? `Chá»n cÃ¡ch phÃ¹ há»£p vá»›i bÃ i ${topic.title.toLowerCase()}.` : level === 3 ? 'HoÃ n thÃ nh chá»— trá»‘ng vÃ  viáº¿t láº¡i toÃ n bá»™ cÃ¢u.' : 'Äiá»n pháº§n cÃ²n thiáº¿u vÃ o chá»— trá»‘ng.',
          answers, options: type === 'choice' ? [fullAnswer ? seed.sentence : seed.focus, fullAnswer ? bad : seed.wrong] : [],
          tokens: type === 'order' ? seed.sentence.split(/\s+/) : [],
          explanation: `${topic.rule}\nCÃ¢u hoÃ n chá»‰nh: ${seed.sentence}`,
          hint: topic.rule, scaffold: level === 1 ? topic.rule : '',
          cue: type === 'fill' ? cue(seed.focus,topic) : '',
          requiredWord: type === 'rewrite' ? seed.word : '',
          theoryUrl: `grammar-theory.html?topic=${topic.id}`
        };
        items.push(question);
      });
