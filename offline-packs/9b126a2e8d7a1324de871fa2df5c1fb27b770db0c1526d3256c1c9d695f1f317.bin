        { question: "23. Researchers (consistently/demonstrate) ________ the benefits of a balanced diet. [IELTS]", answer: "have consistently demonstrated", explanation: "QuÃ¡ trÃ¬nh chá»©ng minh liÃªn tá»¥c kÃ©o dÃ i Ä‘áº¿n nay cá»§a giá»›i khoa há»c." },
        { question: "24. Technological advancements (profoundly/alter) ________ the way we communicate. [IELTS]", answer: "have profoundly altered", explanation: "Sá»± thay Ä‘á»•i sÃ¢u sáº¯c (alter) tÃ¡c Ä‘á»™ng lÃªn cuá»™c sá»‘ng hiá»‡n táº¡i." },
        { question: "25. The newly appointed director (successfully/implement) ________ a cost-cutting strategy. [TOEIC]", answer: "has successfully implemented", explanation: "ÄÃ£ thá»±c thi thÃ nh cÃ´ng má»™t chiáº¿n lÆ°á»£c cÃ³ giÃ¡ trá»‹ hiá»‡n táº¡i." },
        { question: "26. Foreign investment in the region (reach) ________ an unprecedented high. [IELTS]", answer: "has reached", explanation: "Äáº¡t tá»›i má»™t ká»· lá»¥c chÆ°a tá»«ng cÃ³ tÃ­nh Ä‘áº¿n thá»i Ä‘iá»ƒm nÃ y." },
        { question: "27. We (garner) ________ overwhelmingly positive feedback from our beta testers. [TOEIC]", answer: "have garnered", explanation: "Thu tháº­p Ä‘Æ°á»£c (garner) pháº£n há»“i tÃ­nh Ä‘áº¿n nay." },
        { question: "28. Strict environmental regulations (foster) ________ innovation in green energy. [IELTS]", answer: "have fostered", explanation: "CÃ¡c quy Ä‘á»‹nh Ä‘Ã£ vÃ  Ä‘ang thÃºc Ä‘áº©y (foster) sá»± Ä‘á»•i má»›i." },
        { question: "29. The corporation (consolidate) ________ its position as a market leader. [TOEIC]", answer: "has consolidated", explanation: "CÃ´ng ty Ä‘Ã£ cá»§ng cá»‘ vá»¯ng cháº¯c vá»‹ tháº¿ cá»§a mÃ¬nh." },
        { question: "30. Over the last decade, urban sprawl (significantly/reduce) ________ agricultural lands. [IELTS]", answer: "has significantly reduced", explanation: "Dáº¥u hiá»‡u 'Over the last decade' diá»…n táº£ háº­u quáº£ kÃ©o dÃ i Ä‘áº¿n nay." }
    ]
};

    let currentTense = "";
    let currentQuestionIndex = 0;
    let questionsList = [];

    // Khá»Ÿi táº¡o bÃ i táº­p khi chá»n ThÃ¬
    function startQuiz() {
        const selectElement = document.getElementById("tense-select");
        currentTense = selectElement.value;
        questionsList = quizData[currentTense];
        currentQuestionIndex = 0;
        
        document.getElementById("input-area").style.display = "flex";
        loadQuestion();
    }

    // Táº£i cÃ¢u há»i lÃªn giao diá»‡n
    function loadQuestion() {
        resetUI();
        const currentQ = questionsList[currentQuestionIndex];
        
        document.getElementById("progress").innerText = `CÃ¢u: ${currentQuestionIndex + 1}/${questionsList.length}`;
        document.getElementById("question-text").innerHTML = currentQ.question;
    }

    // Kiá»ƒm tra Ä‘Ã¡p Ã¡n
    function checkAnswer() {
        const userAnswer = document.getElementById("answer-input").value.trim().toLowerCase();
        const currentQ = questionsList[currentQuestionIndex];
        
        // Cáº¯t cÃ¡c Ä‘Ã¡p Ã¡n báº±ng dáº¥u "/" vÃ  loáº¡i bá» khoáº£ng tráº¯ng dÆ° thá»«a
        const correctAnswers = currentQ.answer.toLowerCase().split("/").map(item => item.trim());
        
        const feedbackEl = document.getElementById("feedback");
        const explanationEl = document.getElementById("explanation");
        const nextBtn = document.getElementById("next-btn");
        const checkBtn = document.getElementById("check-btn");

        if (userAnswer === "") {
            alert("Vui lÃ²ng nháº­p Ä‘Ã¡p Ã¡n cá»§a báº¡n!");
            return;
        }

        if (correctAnswers.includes(userAnswer)) {
            feedbackEl.innerText = "âœ… ChÃ­nh xÃ¡c!";
            feedbackEl.className = "feedback correct";
        } else {
            // In hoa chá»¯ cÃ¡i Ä‘áº§u cá»§a Ä‘Ã¡p Ã¡n Ä‘á»ƒ hiá»ƒn thá»‹ Ä‘áº¹p hÆ¡n
            const displayAnswer = currentQ.answer;
            feedbackEl.innerText = `âŒ Sai rá»“i! ÄÃ¡p Ã¡n Ä‘Ãºng lÃ : ${displayAnswer}`;
            feedbackEl.className = "feedback incorrect";
        }

        // Hiá»‡n giáº£i thÃ­ch vÃ  nÃºt Next
        explanationEl.innerHTML = `<strong>ðŸ’¡ Giáº£i thÃ­ch:</strong> ${currentQ.explanation}`;
        explanationEl.style.display = "block";
        nextBtn.style.display = "block";
        checkBtn.style.display = "none";
        document.getElementById("answer-input").disabled = true;
    }

    // Chuyá»ƒn cÃ¢u tiáº¿p theo
    function nextQuestion() {
        currentQuestionIndex++;
        if (currentQuestionIndex < questionsList.length) {
            loadQuestion();
        } else {
            document.getElementById("question-text").innerHTML = "<strong>ðŸŽ‰ ChÃºc má»«ng! Báº¡n Ä‘Ã£ hoÃ n thÃ nh xuáº¥t sáº¯c 10 cÃ¢u há»i cá»§a thÃ¬ nÃ y! HÃ£y chá»n thÃ¬ khÃ¡c Ä‘á»ƒ tiáº¿p tá»¥c luyá»‡n táº­p nhÃ©.</strong>";
            document.getElementById("input-area").style.display = "none";
            resetUI();
        }
    }

    // KhÃ´i phá»¥c giao diá»‡n cho cÃ¢u há»i má»›i
    function resetUI() {
        const inputEl = document.getElementById("answer-input");
        if(inputEl) {
            inputEl.value = "";
            inputEl.disabled = false;
            inputEl.focus();
        }
        
        document.getElementById("feedback").innerText = "";
        document.getElementById("explanation").style.display = "none";
        document.getElementById("next-btn").style.display = "none";
        
        const checkBtn = document.getElementById("check-btn");
        if(checkBtn) checkBtn.style.display = "block";
    }

    // Cháº¡y auto láº§n Ä‘áº§u khi load trang
    window.onload = startQuiz;

    // Cho phÃ©p nháº¥n Enter Ä‘á»ƒ kiá»ƒm tra hoáº·c qua cÃ¢u
    document.getElementById("answer-input").addEventListener("keypress", function(event) {
        if (event.key === "Enter") {
            if (document.getElementById("check-btn").style.display !== "none") {
                checkAnswer();
            } else {
                nextQuestion();
            }
        }
    });
(function(root){
 'use strict';
 const KEY='danh-skills-vocabulary-v1',modes=['meaning','listen','spelling','context'],outcomes=['first','corrected','hinted','seen'];
 const normal=s=>String(s||'').normalize('NFC').trim().toLowerCase().replace(/[â€™â€˜]/g,"'").replace(/\s+/g,' ');
 const shuffle=items=>{const out=[...items];for(let i=out.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[out[i],out[j]]=[out[j],out[i]];}return out;};
 const fresh=()=>({version:1,records:{},active:null});
 function context(w){if(!w.example)return null;const escaped=w.term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');const re=new RegExp('(^|[^A-Za-z])'+escaped+'(?=$|[^A-Za-z])','i');return re.test(w.example)?w.example.replace(re,(_,prefix)=>prefix+'____'):null;}
 function validRound(r,byKey){
  return r&&modes.includes(r.mode)&&Array.isArray(r.order)&&r.order.length>0&&r.order.length<=8&&new Set(r.order).size===r.order.length&&r.order.every(k=>byKey.has(k))&&Number.isInteger(r.position)&&r.position>=0&&r.position<=r.order.length&&r.entries&&typeof r.entries==='object'&&r.order.every((k,i)=>{const e=r.entries[k];return e&&typeof e.draft==='string'&&e.draft.length<=250&&Number.isInteger(e.attempts)&&e.attempts>=0&&typeof e.hinted==='boolean'&&(!e.outcome||outcomes.includes(e.outcome))&&(i>=r.position||!!e.outcome)&&Array.isArray(e.options)&&e.options.includes(k)&&new Set(e.options).size===e.options.length&&e.options.every(k=>byKey.has(k));});
 }
 function create(storage,words,now=()=>Date.now()){
  const byKey=new Map(words.map(w=>[w.key,w]));let state=fresh(),warning='';
  try{const s=JSON.parse(storage.getItem(KEY)||'null');if(s?.version===1&&s.records&&typeof s.records==='object'&&!Array.isArray(s.records)){state=s;if(!validRound(s.active,byKey))state.active=null;}}catch{warning='ChÆ°a Ä‘á»c Ä‘Æ°á»£c lÆ°á»£t cÅ©. MÃ¬nh chÆ¡i lÆ°á»£t má»›i nha.';}
  function save(){try{storage.setItem(KEY,JSON.stringify(state));return true;}catch{warning='ChÆ°a lÆ°u Ä‘Æ°á»£c. Giá»¯ tab nÃ y má»Ÿ Ä‘á»ƒ chÆ¡i tiáº¿p nha.';return false;}}
  const recordKey=(k,mode)=>mode+'|'+k;
  function due(w,mode){const r=state.records[recordKey(w.key,mode)];return r&&Number.isFinite(r.due)&&r.due<=now();}
  function start(pool,mode){
   if(!modes.includes(mode))throw Error('Kiá»ƒu chÆ¡i chÆ°a há»£p lá»‡');
   const seen=new Set();const available=shuffle(pool).sort((a,b)=>Number(!!due(b,mode))-Number(!!due(a,mode))).filter(w=>{const n=normal(w.term);if(seen.has(n)||!byKey.has(w.key)||(mode==='context'&&context(w)===null))return false;if(mode!=='spelling'&&!pool.some(x=>normal(x.term)!==n&&normal(x.meaning)!==normal(w.meaning)))return false;seen.add(n);return true;});
   available.sort((a,b)=>Number(!!due(b,mode))-Number(!!due(a,mode)));
   if(!available.length)return false;
   const picked=available.slice(0,8),entries={};
   for(const w of picked){const terms=new Set([normal(w.term)]),meanings=new Set([normal(w.meaning)]);const distractors=shuffle(pool).filter(x=>{if(x.key===w.key||terms.has(normal(x.term))||meanings.has(normal(x.meaning)))return false;terms.add(normal(x.term));meanings.add(normal(x.meaning));return true;}).slice(0,3);entries[w.key]={draft:'',attempts:0,hinted:false,outcome:null,wrong:[],options:shuffle([w,...distractors]).map(x=>x.key)};}
   state.active={version:1,mode,order:picked.map(w=>w.key),position:0,entries,started:now()};save();return true;
  }
  const current=()=>{const r=state.active;return r&&r.position<r.order.length?byKey.get(r.order[r.position]):null;};
  const entry=()=>{const w=current();return w?state.active.entries[w.key]:null;};
  function settle(outcome){const r=state.active,w=current(),e=entry();if(!e||e.outcome)return false;e.outcome=outcome;const k=recordKey(w.key,r.mode),old=state.records[k];const stage=outcome==='first'?Math.min(Number.isInteger(old?.stage)?old.stage+1:0,3):0;state.records[k]={outcome,stage,due:now()+(outcome==='first'?[1,3,7,14][stage]:1)*86400000,at:now()};save();return true;}
  function answer(value){const w=current(),e=entry();if(!e||e.outcome)return 'locked';if(!String(value).trim())return 'empty';e.draft=String(value).slice(0,250);if(normal(value)===normal(w.term)){const kind=e.hinted?'hinted':e.attempts?'corrected':'first';settle(kind);return kind;}if(!Array.isArray(e.wrong))e.wrong=[];if(e.wrong.includes(normal(value)))return 'repeat';e.wrong.push(normal(value));e.attempts++;save();return 'wrong';}
  function hint(){const e=entry();if(!e||e.outcome)return;e.hinted=true;save();}
  function reveal(){return settle('seen');}
  function draft(value){const e=entry();if(e&&!e.outcome){e.draft=String(value).slice(0,250);save();}}
  function next(){const r=state.active,e=entry();if(!r||!e?.outcome)return false;r.position++;save();return true;}
  return {get state(){return state;},get warning(){return warning;},byKey,current,entry,start,answer,hint,reveal,draft,next,due,save};
 }
 const api={KEY,modes,outcomes,normal,shuffle,validRound,context,create};root.DanhVocabularySkillsCore=api;if(typeof module!=='undefined'&&module.exports)module.exports=api;
})(typeof window==='undefined'?globalThis:window);
/* Luyá»‡n ká»¹ nÄƒng dÃ¹ng chung nguá»“n Unit, báº±ng chá»©ng há»c riÃªng theo há»“ sÆ¡. */
(() => {
 'use strict';
 const $=id=>document.getElementById(id),L=window.DanhVocabularyLibrary,C=window.DanhVocabularySkillsCore;
 const modes={cards:'Láº­t tháº»',meaning:'Chá»n nghÄ©a',listen:'Nghe chá»n tá»«',spelling:'GÃµ tá»«',context:'DÃ¹ng trong cÃ¢u',letters:'GhÃ©p chá»¯'};
 let words=[],model,level='Pre A1',mode='meaning',limit=24,flash=null;
 const make=(tag,text,cls)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e;};
 const button=(text,fn,cls='')=>{const e=make('button',text,cls);e.type='button';e.addEventListener('click',fn);return e;};
 const speech=term=>window.DanhAnswerSpeech.listen(term);
 const stop=()=>window.DanhAnswerSpeech.stop();
 function speaker(term){const b=button('ðŸ”Š',()=>speech(term),'speaker');b.setAttribute('aria-label','Nghe '+term);return b;}
 function picture(word){const frame=make('div',undefined,'word-image');if(word.image){const img=make('img');img.src=L.url(word.image);img.alt=word.meaning;img.loading='lazy';img.width=200;img.height=200;img.onerror=()=>frame.replaceChildren(make('span','ðŸŒ±'));frame.append(img);}else frame.textContent=word.icon;window.DanhPictureListen.bind(frame,word.term,word.meaning);return frame;}
 function source(word){const a=make('a',`Lá»›p ${word.sources[0].grade} Â· ${word.sources[0].unit.replace('gsunit','Unit ').replace(/^unit/,'Unit ')}`,'source');a.href=L.url(word.sources[0].path);return a;}
 function filtered(){const grade=Number($('grade-filter').value),unit=$('unit-filter').value,q=C.normal($('search').value);return words.filter(w=>(level==='all'||w.level===level)&&(!grade||w.sources.some(s=>s.grade===grade&&(!unit||s.unit===unit)))&&(!q||C.normal(w.term+' '+w.meaning+' '+w.sources.map(s=>s.title).join(' ')).includes(q)));}
 function updateUnits(){const grade=Number($('grade-filter').value),seen=new Map();for(const w of words)for(const s of w.sources)if(s.grade===grade)seen.set(s.unit,s);$('unit-filter').replaceChildren(new Option('Má»i Unit',''));for(const s of [...seen.values()].sort((a,b)=>Number(a.unit.match(/[0-9]+/)[0])-Number(b.unit.match(/[0-9]+/)[0])))$('unit-filter').append(new Option(s.title,s.unit));$('unit-filter').disabled=!grade;}
 function drawLibrary(){const pool=filtered();$('word-list').replaceChildren();for(const w of pool.slice(0,limit)){const card=make('article',undefined,'word-card'),body=make('div',undefined,'word-body');body.append(make('h3',w.term),make('p',w.meaning));const foot=make('div',undefined,'word-footer'),audio=button('ðŸ”Š',()=>speech(w.term));audio.setAttribute('aria-label','Nghe '+w.term);foot.append(source(w),audio);body.append(foot);card.append(picture(w),body);$('word-list').append(card);}if(!pool.length)$('word-list').append(make('p','ChÆ°a cÃ³ bá»™ phÃ¹ há»£p. Äá»•i lá»±a chá»n nha.','empty'));$('more').hidden=pool.length<=limit;$('start').disabled=!pool.length;$('review').disabled=mode==='letters'?!pool.length:!pool.some(w=>C.modes.some(m=>model.due(w,m)));$('review').textContent=mode==='letters'?'Ã”n ghÃ©p chá»¯':'Ã”n hÃ´m nay';$('message').textContent=model.warning;const hasContext=pool.some(w=>C.context(w)!==null);document.querySelector('[data-mode=context]').disabled=!hasContext;}
 function home(){stop();$('setup').hidden=false;$('play').hidden=true;$('resume').hidden=!model.state.active;$('resume').textContent=model.state.active?.position===model.state.active?.order.length?'Xem lÆ°á»£t vá»«a chÆ¡i':'ChÆ¡i tiáº¿p';drawLibrary();const c=model.state.cards;$('cards-resume').hidden=!(c&&Array.isArray(c.order)&&Number.isInteger(c.index)&&c.index>=0&&c.index<c.order.length&&c.order.every(k=>model.byKey.has(k)));$('cards-resume').onclick=()=>{flash=c;showPlay();renderCards();};}
 function showPlay(){stop();$('setup').hidden=true;$('play').hidden=false;$('play').scrollIntoView({block:'start'});}
 function saveWarning(){if(model.warning)$('message').textContent=model.warning;}
 function launch(pool=filtered()){
  $('message').textContent='';
  model.state.setup={level,mode,grade:$('grade-filter').value,unit:$('unit-filter').value,search:$('search').value};
  if(mode==='letters'){const url=new URL(location.href);url.searchParams.set('game','letters');for(const [key,value] of [['grade',$('grade-filter').value],['unit',$('unit-filter').value],['level',level],['q',$('search').value]]){if(value)url.searchParams.set(key,value);else url.searchParams.delete(key);}history.replaceState(null,'',url);model.save();showPlay();$('round-label').textContent='GhÃ©p chá»¯';$('position').textContent='';window.DanhSiteLetters.mount({stage:$('stage'),words:pool.map(w=>({...w,image:w.image?L.url(w.image):null})),grade:Number($('grade-filter').value)||0,scope:'library'}).render();return;}
  $('stage').classList.remove('letter-ladder');if(new URLSearchParams(location.search).get('game')==='letters'){const url=new URL(location.href);url.searchParams.delete('game');history.replaceState(null,'',url);}
  if(mode==='cards'){const seen=new Set();flash={order:C.shuffle(pool).filter(w=>{const k=C.normal(w.term);if(seen.has(k))return false;seen.add(k);return true;}).slice(0,8).map(w=>w.key),index:0,back:false};model.state.cards=flash;model.save();showPlay();renderCards();return;}
  if(!model.start(pool,mode)){$('message').textContent='Bá»™ nÃ y chÆ°a cÃ³ cÃ¢u phÃ¹ há»£p. Thá»­ kiá»ƒu chÆ¡i khÃ¡c nha.';return;}showPlay();render();
 }
 function renderCards(){const stage=$('stage');stage.replaceChildren();const w=model.byKey.get(flash.order[flash.index]);if(!w){home();return;}window.DanhGameFlow?.prepare(flash.order.slice(flash.index,flash.index+3).map(key=>model.byKey.get(key)),stage);$('round-label').textContent='Láº­t tháº»';$('position').textContent=`${flash.index+1}/${flash.order.length}`;const card=window.DanhPictureListen.flipSurface(()=>{flash.back=!flash.back;model.save();renderCards();},'flip-card button');card.setAttribute('aria-label',flash.back?'Xem tá»« tiáº¿ng Anh':'Láº­t xem nghÄ©a');if(flash.back)card.append(make('strong',w.meaning),make('small',w.term));else card.append(picture(w),make('strong',w.term),make('small',w.ipa));stage.append(card);if(flash.back)stage.append(speaker(w.term));if(flash.back&&w.example)stage.append(make('p',w.example,'example'));const nav=make('div',undefined,'actions'),previous=button('Tháº» trÆ°á»›c',()=>{flash.index--;flash.back=false;model.save();renderCards();});previous.disabled=flash.index===0;nav.append(previous,button(flash.index===flash.order.length-1?'Chá»n lÆ°á»£t khÃ¡c':'Tháº» tiáº¿p',()=>{if(flash.index===flash.order.length-1){home();return;}flash.index++;flash.back=false;model.save();renderCards();},'primary'));stage.append(nav);}
 function render(){
  const r=model.state.active,stage=$('stage');stage.replaceChildren();if(!r){home();return;}$('round-label').textContent=modes[r.mode];$('position').textContent=`${Math.min(r.position+1,r.order.length)}/${r.order.length}`;
  if(r.position>=r.order.length){results();return;}
  const w=model.current(),e=model.entry();
  window.DanhGameFlow?.prepare(r.order.slice(r.position,r.position+3).map(key=>model.byKey.get(key)),stage);
  stage.append(make('h2',r.mode==='listen'?'Tá»« nÃ o vá»«a vang lÃªn?':r.mode==='spelling'?w.meaning:r.mode==='context'?'Äiá»n tá»« cÃ²n thiáº¿u':w.term));
  if(r.mode==='meaning')stage.append(speaker(w.term));
  else if(r.mode==='listen')stage.append(speaker(w.term));
  else if(r.mode==='spelling')stage.append(picture(w));
  else stage.append(make('p',C.context(w),'question'));
  const feedback=make('p',undefined,'feedback');feedback.setAttribute('role','status');feedback.setAttribute('aria-live','polite');
  if(r.mode==='spelling'){
   const form=make('form'),label=make('label','GÃµ tá»« tiáº¿ng Anh'),input=make('input');input.id='word-answer';label.htmlFor=input.id;input.autocomplete='off';input.spellcheck=false;input.maxLength=250;input.value=e.draft;input.disabled=!!e.outcome;input.addEventListener('input',()=>model.draft(input.value));const check=make('button','Kiá»ƒm tra','primary');check.type='submit';check.disabled=!!e.outcome;form.append(label,input,check);form.addEventListener('submit',event=>{event.preventDefault();respond(input.value,feedback);});stage.append(form);
  }else{
   const choices=make('div',undefined,'choices');for(const k of e.options){const candidate=model.byKey.get(k),b=button(r.mode==='meaning'?candidate.meaning:candidate.term,()=>respond(candidate.term,feedback));b.disabled=!!e.outcome||e.wrong?.includes(C.normal(candidate.term));if(e.wrong?.includes(C.normal(candidate.term)))b.classList.add('bad');if(e.outcome&&k===w.key)b.classList.add('good');b.dataset.choiceKey=k;choices.append(b);}stage.append(choices);
  }
  stage.append(feedback);if(e.attempts&&!e.outcome)feedback.textContent='ChÆ°a Ä‘Ãºng rá»“i, thá»­ láº¡i nha.';
  if(e.hinted&&!e.outcome){const hint=r.mode==='meaning'&&w.example?w.example:`Chá»¯ Ä‘áº§u: ${w.term[0].toUpperCase()}`;stage.append(make('p',hint,'hint'));}
  if(e.outcome){feedback.textContent=e.outcome==='seen'?`ÄÃ¡p Ã¡n: ${w.term} Â· ${w.meaning}`:e.outcome==='first'?'â­':e.outcome==='hinted'?'ÄÃºng vá»›i gá»£i Ã½ rá»“i nha!':'Tá»± sá»­a Ä‘Ãºng rá»“i, xá»‹n Ä‘Ã³!';if(w.example)stage.append(make('p',w.example,'example'));if(r.mode!=='spelling')stage.append(speaker(w.term));stage.append(source(w));const actions=make('div',undefined,'actions');actions.append(button(r.position===r.order.length-1?'Xem káº¿t quáº£':'CÃ¢u tiáº¿p',()=>{stop();model.next();render();},'primary'));stage.append(actions);
  }else{
   const actions=make('div',undefined,'actions');actions.append(button('Gá»£i Ã½',()=>{model.hint();render();}));if(e.attempts||e.hinted)actions.append(button('Xem Ä‘Ã¡p Ã¡n',()=>{model.reveal();window.DanhLearningEffects.feedback('help');render();}));stage.append(actions);
  }
  if(model.warning)stage.append(make('p',model.warning,'notice'));
 }
 function respond(value,feedback){const w=model.current(),result=model.answer(value);if(result==='locked'||result==='repeat')return;if(result==='empty'){feedback.textContent='GÃµ má»™t tá»« trÆ°á»›c nha.';return;}if(result==='wrong'){window.DanhLearningEffects.feedback('bad');render();$('stage').querySelector('.feedback').textContent='ChÆ°a Ä‘Ãºng rá»“i, thá»­ láº¡i nha.';const focus=$('word-answer')||$('stage').querySelector('.choices button:not(:disabled)');focus?.focus();return;}window.DanhLearningEffects.feedback(result==='first'?'good':'corrected');render();$('stage').querySelector('.actions button')?.focus();window.DanhAnswerSpeech.say(w.term);}
 function results(){const r=model.state.active,stage=$('stage');stage.append(make('h2','LÆ°á»£t nÃ y xá»‹n Ä‘Ã³! ðŸŒŸ'));const grid=make('div',undefined,'result-grid');for(const [kind,label] of [['first','ÄÃºng ngay'],['corrected','Tá»± sá»­a'],['hinted','CÃ³ gá»£i Ã½'],['seen','ÄÃ£ xem']]){const p=make('p');p.append(make('strong',String(r.order.filter(k=>r.entries[k].outcome===kind).length)),make('span',label));grid.append(p);}stage.append(grid);const weak=r.order.filter(k=>r.entries[k].outcome!=='first').map(k=>model.byKey.get(k)),actions=make('div',undefined,'actions');if(weak.length)actions.append(button('Ã”n pháº§n cÃ²n khÃ³',()=>{mode=r.mode;launch(weak);},'primary'));actions.append(button('LÆ°á»£t má»›i',()=>{mode=r.mode;launch();},weak.length?'':'primary'),button('Chá»n bá»™ khÃ¡c',home));stage.append(actions);}
 document.querySelectorAll('[data-level]').forEach(b=>b.addEventListener('click',()=>{level=b.dataset.level;limit=24;document.querySelectorAll('[data-level]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));drawLibrary();}));
 document.querySelectorAll('[data-mode]').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode;document.querySelectorAll('[data-mode]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));drawLibrary();}));
 $('grade-filter').addEventListener('change',()=>{updateUnits();limit=24;drawLibrary();});for(const id of ['unit-filter','search'])$(id).addEventListener(id==='search'?'input':'change',()=>{limit=24;drawLibrary();});
 $('more').addEventListener('click',()=>{limit+=24;drawLibrary();});$('start').addEventListener('click',()=>launch());$('back').addEventListener('click',home);$('resume').addEventListener('click',()=>{showPlay();render();});$('review').addEventListener('click',()=>{const pool=filtered();if(mode==='letters'){launch(pool);return;}const chosen=mode!=='cards'&&pool.some(w=>model.due(w,mode))?mode:C.modes.find(m=>pool.some(w=>model.due(w,m)));if(chosen){mode=chosen;launch(pool.filter(w=>model.due(w,chosen)));}});
 L.load().then(all=>{words=all;model=C.create(window.DanhLearners.storage,words);const saved=model.state.setup;if(saved&&['Pre A1','A1','A2','B1','B2','C1','C2','all'].includes(saved.level)){level=saved.level;if(Object.hasOwn(modes,saved.mode))mode=saved.mode;$('grade-filter').value=String(saved.grade||'');updateUnits();if([...$('unit-filter').options].some(o=>o.value===saved.unit))$('unit-filter').value=saved.unit;$('search').value=String(saved.search||'').slice(0,100);document.querySelectorAll('[data-level]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.level===level)));document.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.mode===mode)));}else updateUnits();const letterQuery=new URLSearchParams(location.search);if(letterQuery.get('game')==='letters'){mode='letters';level=['Pre A1','A1','A2','B1','B2','C1','C2','all'].includes(letterQuery.get('level'))?letterQuery.get('level'):'all';$('search').value=letterQuery.get('q')||'';const g=Number(letterQuery.get('grade'));if(g>=1&&g<=12)$('grade-filter').value=String(g);updateUnits();const unit=letterQuery.get('unit');if([...$('unit-filter').options].some(o=>o.value===unit))$('unit-filter').value=unit;document.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.mode===mode)));document.querySelectorAll('[data-level]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.level===level)));}$('loading').hidden=true;$('workbench').hidden=false;for(const b of document.querySelectorAll('[data-level]'))b.disabled=!words.some(w=>b.dataset.level==='all'||w.level===b.dataset.level);home();if(letterQuery.get('game')==='letters'&&filtered().length)launch();if(model.state.cards?.order?.every(k=>model.byKey.has(k))){const c=model.state.cards;if(Number.isInteger(c.index)&&c.index>=0&&c.index<c.order.length){$('cards-resume').hidden=false;$('cards-resume').onclick=()=>{flash=c;showPlay();renderCards();};}}}).catch(error=>{$('loading').textContent=error.message;$('loading').append(button('Thá»­ láº¡i',()=>location.reload()));});
})();
const quizData = [
        // --- LEVEL 1: CÆ  Báº¢N (1-20) ---
        { q: "1. She is a very (beauty) _____ girl. [CÆ¡ báº£n]", a: "beautiful", e: "Äá»©ng trÆ°á»›c danh tá»« 'girl' cáº§n má»™t TÃ­nh tá»«. TÃ­nh tá»« cá»§a beauty lÃ  beautiful." },
