  const person = '<circle cx="43" cy="54" r="11" fill="#f3be9d"/><path d="M32 49q11-18 22 0" fill="none" stroke="#614b43" stroke-width="5"/><path d="M28 92V76q14-18 30 0v16" fill="#6f9fd1" stroke="#36516a" stroke-width="3"/>';
