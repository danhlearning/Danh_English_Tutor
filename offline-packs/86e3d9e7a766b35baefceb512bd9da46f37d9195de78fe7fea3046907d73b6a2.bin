.g6-catalog{font-family:"Danh Nunito",Nunito,sans-serif;background:#f8faf7;color:#233f40}
.g6-catalog .g6-shell{width:min(1120px,calc(100% - 40px))}
.g6-catalog-header{display:flex;align-items:center;justify-content:space-between;gap:14px;padding-block:18px;font-weight:800;font-size:.88rem}
.g6-home-link{display:inline-flex;align-items:center;min-height:44px;color:#45605b;text-decoration:none}
.g6-catalog-header>span{color:#6c7e78}
.g6-cover{position:relative;isolation:isolate;display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;min-height:385px;overflow:hidden;border:1px solid #e5e9dc;border-radius:30px;background:#fffdf4;box-shadow:0 12px 35px #40543b0a}
.g6-cover-copy{position:relative;z-index:2;padding:34px 0 36px 42px}
.g6-cover-tag{font-size:.75rem;letter-spacing:.12em;font-weight:900;color:#66856b;margin:0 0 18px}
.g6-cover h1{font-size:clamp(2.8rem,5vw,4.7rem);line-height:1.04;letter-spacing:-.035em;margin:0 0 28px;font-weight:900;color:#274e4b}
.g6-cover h1 span{color:#df713d}
.g6-cover-cta{display:inline-flex;align-items:center;gap:25px;min-height:50px;border-radius:15px;background:#237569;color:white;text-decoration:none;padding:12px 21px;font-weight:900;box-shadow:0 5px 0 #16584e;transition:transform .18s}
.g6-cover-cta:hover{transform:translateY(-2px);background:#1c685d}
.g6-cover-cta>span{font-size:1.4rem}
.g6-cover-picture{position:relative;align-self:stretch;display:grid;align-items:center;min-width:0}
.g6-cover-picture img{display:block;width:130%;max-width:none;height:auto;margin-left:-22%;mix-blend-mode:multiply;animation:g6-pencil-drift 7s ease-in-out infinite}
.g6-cover-star{position:absolute;right:11%;top:14%;color:#eeae36;font-size:2.3rem;animation:g6-pencil-star 5s ease-in-out infinite}
.g6-quick-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:20px 0 34px}
.g6-quick-paths>a{display:flex;align-items:center;gap:12px;text-decoration:none;background:#fff;border:1px solid #e1e9e2;border-radius:18px;padding:17px;transition:transform .18s,border-color .18s}
.g6-quick-paths>a:hover{transform:translateY(-3px);border-color:#91b6a7}
.g6-path-icon{display:grid;place-items:center;flex:none;width:43px;height:43px;border-radius:13px;background:#edf6ee;font-size:1.6rem}
.g6-quick-paths>a:nth-child(2) .g6-path-icon{background:#fff5d9}.g6-quick-paths>a:nth-child(3) .g6-path-icon{background:#eaf2fc}
.g6-quick-paths strong{display:block;font-size:1rem}.g6-quick-paths small{display:block;color:#72817a;margin-top:3px;font-size:.8rem}.g6-quick-paths b{margin-left:auto;color:#82968a;font-size:1.3rem}
.g6-catalog .g6-section{margin:0 0 35px;scroll-margin-top:18px}.g6-catalog .g6-section-head{margin-bottom:17px;align-items:center}.g6-catalog .g6-section-head h2,.g6-catalog .g6-grammar h2{font-size:clamp(1.45rem,2.5vw,1.9rem);margin:0 0 3px}.g6-catalog .g6-count{font-size:.8rem;padding:7px 12px;background:#edf2e8;color:#638063}
.g6-catalog .g6-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.g6-catalog .g6-unit-card{position:relative;border:1px solid #e0e8df;border-top:3px solid var(--unit-color);border-radius:18px;padding:17px 18px;box-shadow:none;min-height:166px}
.g6-catalog .g6-unit-card:hover{border-color:var(--unit-color);box-shadow:0 7px 20px #2e594d10}
.g6-catalog .g6-unit-number{font-size:.7rem;letter-spacing:.08em}.g6-catalog .g6-unit-icon{font-size:1.8rem;line-height:1.2}.g6-catalog .g6-unit-card h3{font-size:1.08rem;line-height:1.3;margin:12px 0 5px;padding-right:10px}.g6-catalog .g6-unit-card p{font-size:.82rem;line-height:1.4;padding-right:15px;color:#718177}
.g6-catalog .g6-card-bottom{position:absolute;right:12px;bottom:10px;border:0;margin:0;padding:0;font-size:1.1rem}.g6-catalog .g6-card-bottom strong{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:#f1f6f0}
.g6-catalog .vg-review-grid{gap:12px}.g6-catalog .vg-review-card{position:relative;padding:22px;border-radius:20px;box-shadow:none;border:1px solid #e3e9da;background:#fffdf1}.g6-catalog .vg-review-card:nth-child(2){background:#edf6f8;border-color:#dce9e8}.g6-catalog .vg-review-card>span{font-size:2rem}.g6-catalog .vg-review-card h3{font-size:1.3rem;margin:8px 0 5px}.g6-catalog .vg-review-card p{font-size:.9rem;margin:0 0 13px}.g6-catalog .vg-review-card strong{font-size:.9rem}
.g6-catalog .g6-grammar{padding:24px;gap:20px;border-radius:20px;background:#fff;border-color:#e0e8df}.g6-catalog .g6-grammar-icon{width:65px;height:65px;font-size:2.2rem;background:#f0edf8}.g6-catalog .g6-grammar .g6-hero-link{padding:10px 16px;margin-top:13px;background:#237569;border-radius:12px;font-size:.9rem}.g6-catalog .g6-grammar p{font-size:.95rem}
.g6-catalog a:focus-visible{outline:3px solid #dc9b4b;outline-offset:4px}
@keyframes g6-pencil-drift{0%,100%{transform:translateY(0) rotate(-.3deg)}50%{transform:translateY(-6px) rotate(.3deg)}}
@keyframes g6-pencil-star{0%,100%{transform:rotate(-8deg) scale(.9)}50%{transform:rotate(10deg) scale(1.08)}}
@media(max-width:900px){.g6-catalog .g6-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.g6-cover-copy{padding-left:27px}.g6-cover{min-height:330px}.g6-quick-paths>a{padding:13px;gap:9px}.g6-quick-paths small{display:none}}
@media(max-width:600px){.g6-catalog .g6-shell{width:calc(100% - 28px)}.g6-catalog-header{padding-block:9px;font-size:.8rem}.g6-cover{grid-template-columns:1fr;border-radius:24px;min-height:0}.g6-cover-copy{padding:26px 25px 0}.g6-cover-tag{font-size:.67rem;margin-bottom:10px}.g6-cover h1{font-size:2.8rem;margin-bottom:18px}.g6-cover h1 br{display:none}.g6-cover-cta{min-height:46px;padding:9px 17px;gap:20px;font-size:.95rem}.g6-cover-picture{margin-top:-28px;pointer-events:none}.g6-cover-picture img{width:100%;margin:0}.g6-cover-star{top:21%;font-size:1.6rem}.g6-quick-paths{gap:7px;margin:14px 0 27px}.g6-quick-paths>a{padding:12px 5px;flex-direction:column;text-align:center;gap:7px;border-radius:14px}.g6-path-icon{width:34px;height:34px;font-size:1.3rem;border-radius:10px}.g6-quick-paths strong{font-size:.75rem;line-height:1.35}.g6-quick-paths b{display:none}.g6-catalog .g6-section-head{flex-direction:row;gap:10px}.g6-catalog .g6-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.g6-catalog .g6-unit-card{padding:13px;min-height:164px}.g6-catalog .g6-unit-card h3{font-size:1rem;padding-right:0}.g6-catalog .g6-unit-card p{font-size:.78rem}.g6-catalog .g6-unit-icon{font-size:1.6rem}.g6-catalog .g6-unit-number{font-size:.65rem}.g6-catalog .vg-review-card{padding:18px}.g6-catalog .g6-grammar{padding:20px;gap:12px}.g6-catalog .g6-grammar>div:nth-child(2){flex-basis:calc(100% - 77px)}}
@media(prefers-reduced-motion:reduce){.g6-cover-picture img,.g6-cover-star{animation:none}.g6-catalog a{transition:none}.g6-catalog a:hover{transform:none}}
/* Keep the cover compact while preserving the complete drawing. */
@media(min-width:601px){.g6-cover{height:410px;min-height:0}.g6-cover-picture{position:absolute;inset:0 0 0 34%;height:auto;min-height:0}.g6-cover-picture img{position:absolute;right:0;width:130%;height:100%;object-fit:contain;object-position:right center;margin:0}}
@media(min-width:601px) and (max-width:900px){.g6-cover{height:330px}}
@media(max-width:600px){.g6-cover h1 br{display:initial}}

/* Paper palette and sizing across phones, tablets and desktop. */
body.g6-catalog{
  --g6-paper:#fcf5e5;--g6-surface:#fffaf0;--g6-paper-line:#e9dcc2;
  --danh-profile-background:var(--g6-paper);--danh-profile-border:var(--g6-paper-line);
  --danh-profile-accent:#237569;--danh-profile-accent-hover:#1c685d;
  --danh-profile-button-shadow:#16584e;
  --danh-profile-inset:max(32px,calc((100vw - 1240px)/2));
  --danh-contact-background:var(--g6-paper);--danh-contact-border:var(--g6-paper-line);
  --danh-footer-background:#f3e8d2;--danh-footer-color:#39544c;
  background:var(--g6-paper);color:#294b45;
}
body.g6-catalog .g6-shell{width:min(1240px,calc(100% - 64px))}
body.g6-catalog .g6-cover{background:var(--g6-paper);border-color:var(--g6-paper-line);box-shadow:0 10px 30px #735b2f08}
.g6-cover-picture img{mix-blend-mode:normal}
body.g6-catalog .g6-quick-paths>a{background:var(--g6-surface);border-color:var(--g6-paper-line);min-height:86px}
body.g6-catalog .g6-quick-paths strong{font-size:1.05rem}
body.g6-catalog .g6-quick-paths small{font-size:.875rem;color:#5a6e61}
body.g6-catalog :is(.g6-unit-card,.vg-review-card){background:var(--g6-surface);border:1px solid var(--g6-paper-line);border-top:3px solid var(--tile-accent);box-shadow:0 5px 16px #735b2f08}
body.g6-catalog .g6-unit-card{display:flex;flex-direction:column;min-height:182px;padding:18px;gap:0}
body.g6-catalog .g6-unit-card h3{font-size:1.125rem;line-height:1.35;margin:12px 0 6px;padding:0;overflow-wrap:break-word}
body.g6-catalog .g6-unit-card p{font-size:.9rem;line-height:1.5;color:#5a6e61;padding:0}
body.g6-catalog .g6-card-bottom{position:static;margin-top:auto;padding-top:10px;align-self:flex-end}
body.g6-catalog .g6-card-bottom strong{background:#f2ead8;color:#547364}
body.g6-catalog .g6-unit-number{font-size:.75rem}
body.g6-catalog .g6-grid{gap:16px}
body.g6-catalog .g6-count{background:#f2ead8;color:#53694d}
body.g6-catalog .g6-section{margin-bottom:40px}
body.g6-catalog .g6-grammar{background:var(--g6-surface);border-color:var(--g6-paper-line)}
body.g6-catalog .vg-review-card{padding:24px}
body.g6-catalog .vg-review-card:nth-child(2){background:var(--g6-surface);border-color:var(--g6-paper-line);border-top-color:var(--tile-accent)}
body.g6-catalog .vg-review-card strong{color:#237569}
body.g6-catalog .vg-review-card p,body.g6-catalog .g6-grammar p{font-size:1rem;line-height:1.6;color:#5a6e61}
body.g6-catalog .g6-grammar .g6-hero-link{min-height:46px;align-items:center;box-shadow:0 4px 0 #16584e}
@media(min-width:601px){body.g6-catalog .g6-cover{height:clamp(340px,33vw,440px)}}
@media(min-width:601px) and (max-width:1023px){
  body.g6-catalog{--danh-profile-inset:24px}
  body.g6-catalog .g6-shell{width:calc(100% - 48px)}
  body.g6-catalog .g6-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  body.g6-catalog .g6-cover-copy{padding-left:28px}
  body.g6-catalog .g6-quick-paths small{display:none}
}
@media(min-width:1024px){body.g6-catalog .g6-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:600px){
  body.g6-catalog{--danh-profile-inset:16px}
  body.g6-catalog .g6-shell{width:calc(100% - 32px)}
  body.g6-catalog .g6-catalog-header{padding-block:8px}
  body.g6-catalog .g6-cover{border-radius:22px}
  body.g6-catalog .g6-cover-copy{padding:22px 22px 0}
  body.g6-catalog .g6-cover h1{font-size:clamp(2.35rem,10.5vw,2.85rem);margin-bottom:16px;line-height:1.05}
  body.g6-catalog .g6-cover-picture{margin-top:-48px}
  body.g6-catalog .g6-cover-tag{font-size:.7rem;letter-spacing:.08em;margin-bottom:9px}
  body.g6-catalog .g6-cover-cta{min-height:46px;padding:10px 18px;gap:24px;font-size:1rem}
  body.g6-catalog .g6-quick-paths{gap:8px;margin:16px 0 28px}
  body.g6-catalog .g6-quick-paths>a{padding:12px 5px;min-height:100px;justify-content:center}
  body.g6-catalog .g6-quick-paths strong{font-size:.85rem;line-height:1.4}
  body.g6-catalog .g6-quick-paths small{display:none}
  body.g6-catalog .g6-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  body.g6-catalog .g6-unit-card{min-height:184px;padding:14px}
  body.g6-catalog .g6-unit-card h3{font-size:1.075rem}
  body.g6-catalog .g6-unit-card p{font-size:.875rem}
  body.g6-catalog .g6-unit-number{font-size:.7rem}
  body.g6-catalog .g6-section-head h2{font-size:1.45rem}
  body.g6-catalog .g6-section{margin-bottom:30px}
  body.g6-catalog .vg-review-grid{grid-template-columns:1fr 1fr;gap:12px}
  body.g6-catalog .vg-review-card{padding:16px}
  body.g6-catalog .vg-review-card h3{font-size:1.15rem}
  body.g6-catalog .vg-review-card p{font-size:.875rem}
  body.g6-catalog .vg-review-card strong{font-size:.875rem;display:inline-flex;align-items:center;min-height:44px}
  body.g6-catalog .g6-grammar{gap:12px;padding:20px}
  body.g6-catalog .g6-grammar-icon{width:48px;height:48px;font-size:1.8rem}
  body.g6-catalog .g6-grammar>div:nth-child(2){flex-basis:calc(100% - 60px)}
}
:root{font-family:Nunito,system-ui,sans-serif;color:#153044;background:#f5f8fc;--unit-color:#2563eb}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}button,input{font:inherit}button{cursor:pointer}a{color:inherit}.g6-shell{width:min(1120px,calc(100% - 36px));margin:auto}.g6-hero{background:linear-gradient(125deg,#103b69 0%,#176d9e 62%,#26a8a0 100%);color:white;padding:24px 0 64px;overflow:hidden}.g6-back{display:inline-flex;text-decoration:none;color:white;font-weight:800;background:#ffffff22;padding:9px 15px;border-radius:100px}.g6-back:hover{background:#ffffff33}.g6-hero-inner{display:flex;justify-content:space-between;align-items:center;gap:30px;padding-top:54px}.g6-kicker,.g6-overline{letter-spacing:.12em;font-size:.78rem;font-weight:800;margin:0 0 12px}.g6-hero h1{font-size:clamp(2.6rem,6vw,4.8rem);line-height:1.08;margin:0 0 14px}.g6-lead{font-size:1.18rem;max-width:560px;margin:0 0 28px;line-height:1.55}.g6-hero-link{display:inline-flex;text-decoration:none;background:#fff;color:#164c76;border-radius:14px;padding:13px 21px;font-weight:800;box-shadow:0 8px 25px #0b254455}.g6-hero-art{position:relative;min-width:280px;height:220px}.g6-hero-art span{position:absolute;display:grid;place-items:center;background:#ffffff2e;border:1px solid #ffffff55;border-radius:28px;box-shadow:0 20px 40px #0b254433}.g6-hero-art span:first-child{width:150px;height:150px;font-size:5rem;top:0;left:62px;transform:rotate(-8deg)}.g6-hero-art span:nth-child(2){width:90px;height:90px;font-size:3rem;bottom:0;left:5px;transform:rotate(10deg)}.g6-hero-art span:last-child{width:100px;height:100px;font-size:3.3rem;bottom:5px;right:0;transform:rotate(12deg)}.g6-section-nav{display:flex;gap:12px;flex-wrap:wrap;margin:-26px 0 42px;position:relative}.g6-section-nav a{background:white;text-decoration:none;padding:14px 20px;border-radius:14px;font-weight:800;box-shadow:0 8px 28px #102d4d18}.g6-section-nav a:hover{color:#176d9e}.g6-section{margin:34px 0 50px;scroll-margin-top:24px}.g6-section-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:24px}.g6-section-head h2,.g6-grammar h2{font-size:clamp(1.8rem,3vw,2.4rem);margin:0 0 6px}.g6-section-head p:not(.g6-overline),.g6-grammar p:not(.g6-overline){color:#536779;margin:0;line-height:1.6}.g6-overline{color:#127c91}.g6-count,.g6-soon{white-space:nowrap;background:#e1f4f5;color:#0b6b7b;padding:10px 15px;border-radius:100px;font-weight:800}.g6-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.g6-unit-card{display:block;text-decoration:none;background:#fff;border:1px solid #e1e9f0;border-top:5px solid var(--unit-color);border-radius:18px;padding:21px;box-shadow:0 6px 22px #12344c0d;transition:transform .2s,box-shadow .2s}.g6-unit-card:hover{transform:translateY(-4px);box-shadow:0 14px 28px #12344c1d}.g6-card-top{display:flex;justify-content:space-between;align-items:center}.g6-unit-number,.g6-card-position{color:var(--unit-color,#176d9e);font-weight:800;font-size:.8rem;letter-spacing:.1em}.g6-unit-icon{font-size:2.6rem}.g6-unit-card h3{font-size:1.32rem;margin:18px 0 2px}.g6-unit-card p{color:#647588;margin:0}.g6-card-bottom{border-top:1px solid #e8edf3;margin-top:20px;padding-top:16px;display:flex;justify-content:space-between;gap:8px;font-size:.9rem}.g6-card-bottom strong{color:var(--unit-color)}.g6-grammar{display:flex;align-items:center;gap:24px;padding:28px;background:#fff;border:1px solid #e1e9f0;border-radius:20px}.g6-grammar-icon{flex:none;display:grid;place-items:center;width:84px;height:84px;background:#edf6fc;border-radius:20px;font-size:2.8rem}.g6-grammar>div:nth-child(2){flex:1}.g6-source{color:#697b8b;font-size:.88rem;line-height:1.6;margin:0 0 46px}.g6-source a{color:#176d9e}.g6-lesson-hero{background:linear-gradient(115deg,#183c64,#246b91);color:#fff;padding:22px 0 38px}.g6-lesson-hero-inner{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-top:28px}.g6-lesson-hero h1{font-size:clamp(2rem,5vw,3.5rem);margin:5px 0}.g6-lesson-hero p{margin:0}.g6-lesson-icon{font-size:5rem;background:#ffffff20;width:130px;height:130px;border-radius:26px;display:grid;place-items:center}.g6-lesson-main{padding-top:28px}.g6-progress{display:inline-block;background:#e0f3f4;color:#0e6674;font-weight:800;border-radius:100px;padding:9px 15px;margin-bottom:20px}.g6-tabs{display:flex;gap:9px;flex-wrap:wrap;border-bottom:1px solid #d8e5ef;padding-bottom:12px;margin-bottom:26px}.g6-tab{border:1px solid #d4e2eb;border-radius:100px;background:#fff;color:#355468;font-weight:800;padding:10px 17px}.g6-tab.active{background:#1b627f;border-color:#1b627f;color:white}.g6-panel{min-height:330px}.g6-panel[hidden]{display:none}.g6-panel h2{font-size:1.8rem;margin:0 0 7px}.g6-note{color:#647588;line-height:1.6;margin:0 0 22px}.g6-word-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.g6-word-card{background:white;border:1px solid #e2eaf0;border-radius:18px;padding:20px;box-shadow:0 4px 18px #12344c0b}.g6-word-icon{font-size:2.5rem;display:block}.g6-word-card h3{font-size:1.45rem;margin:8px 0 0}.g6-meaning{font-weight:800;color:#147283;margin:2px 0}.g6-example{font-style:italic;color:#506779;margin:10px 0 16px;line-height:1.5}.g6-sound,.g6-secondary{border:1px solid #b6d8e4;border-radius:10px;background:#edf8fb;color:#0d657a;padding:9px 15px;font-weight:800}.g6-sound:hover,.g6-secondary:hover{background:#d9f0f6}.g6-flash-wrap{max-width:620px;margin:auto}.g6-flashcard{width:100%;min-height:300px;background:linear-gradient(145deg,#fff,#edf7fa);border:2px solid #b9dce7;border-radius:24px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:25px;text-align:center;color:#17364c;box-shadow:0 10px 30px #12344c16}.g6-flashcard strong{font-size:clamp(1.8rem,4vw,2.5rem)}.g6-flashcard span:last-child{color:#607487}.g6-flash-icon{font-size:4rem}.g6-flash-controls{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:16px}.g6-primary{border:0;border-radius:10px;background:#176d8a;color:white;font-weight:800;padding:11px 18px}.g6-primary:hover{background:#0e5470}.g6-primary:disabled{opacity:.5;cursor:default}.g6-stage{background:#fff;border:1px solid #e0e9f0;border-radius:18px;padding:26px;max-width:700px;box-shadow:0 5px 24px #12344c0c}.g6-stage h3{font-size:1.5rem;margin:12px 0 20px}.g6-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.g6-choice{background:#f5f9fc;border:1px solid #d7e3ec;border-radius:12px;padding:14px;text-align:left;font-weight:700;color:#26475b}.g6-choice:hover:not(:disabled){background:#e8f5fa}.g6-choice.correct{background:#e2f7e9;border-color:#5abd78;color:#176d36}.g6-choice.wrong{background:#fbe9e9;border-color:#e39797;color:#b04141}.g6-feedback{min-height:1.5em;font-weight:800;color:#286777}.g6-answer{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}.g6-answer input{flex:1;min-width:180px;border:1px solid #becfdc;border-radius:10px;padding:10px 13px}.g6-answer input:focus{outline:3px solid #9edce6}.g6-grammar-unit{background:#fff;border:1px solid #e0e9f0;border-radius:18px;padding:30px;max-width:700px}.g6-unit-footer{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:30px 0}.g6-unit-footer a{font-weight:800;color:#176d8a}#speech-note{min-height:1.5em;color:#4d7382}@media(max-width:820px){.g6-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.g6-hero-art{min-width:210px;transform:scale(.8);transform-origin:right center}.g6-grammar{align-items:flex-start;flex-wrap:wrap}}@media(max-width:570px){.g6-shell{width:min(100% - 28px,1120px)}.g6-hero{padding-bottom:50px}.g6-hero-inner{padding-top:40px}.g6-hero-art{display:none}.g6-grid,.g6-word-grid,.g6-choices{grid-template-columns:1fr}.g6-section-head{align-items:start;flex-direction:column;gap:12px}.g6-grammar-icon{width:64px;height:64px;font-size:2rem}.g6-grammar{gap:15px;padding:20px}.g6-grammar>div:nth-child(2){flex-basis:calc(100% - 80px)}.g6-lesson-icon{width:80px;height:80px;font-size:3rem}.g6-stage{padding:18px}.g6-tab{padding:9px 13px;font-size:.9rem}}
.g6-grammar .g6-hero-link{margin-top:16px;background:#176d8a;color:#fff;box-shadow:none}.g6-grammar .g6-hero-link:hover{background:#0e5672}
.gg-hero{background:radial-gradient(circle at 85% 25%,#2bafba 0,#176890 35%,#173b68 100%);color:white;padding:22px 0 67px;overflow:hidden}.gg-hero-content{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-top:45px}.gg-hero h1{font-size:clamp(2.5rem,5vw,4rem);line-height:1.1;margin:0 0 12px}.gg-hero p:last-child{font-size:1.12rem;line-height:1.6;max-width:620px;margin:0}.gg-hero-badge{font-size:4rem;width:175px;height:175px;display:grid;place-items:center;position:relative;background:#ffffff24;border:1px solid #ffffff55;border-radius:35px;transform:rotate(9deg)}.gg-hero-badge span{position:absolute;font-size:4rem;transform:rotate(-14deg)}.gg-main{padding-bottom:35px}.gg-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:-34px 0 34px;position:relative}.gg-stats>div{background:#fff;border:1px solid #e1e9f0;border-radius:16px;padding:15px 19px;box-shadow:0 7px 22px #102d4d15}.gg-stats span{display:block;color:#647588;font-weight:700;font-size:.86rem}.gg-stats strong{display:block;font-size:1.65rem;color:#194f70;margin-top:2px}.gg-setup,.gg-result,.gg-info{background:#fff;border:1px solid #e1e9f0;border-radius:22px;padding:29px;box-shadow:0 6px 25px #12344c0c}.gg-setup[hidden],.gg-play[hidden],.gg-result[hidden]{display:none}.gg-heading{display:flex;justify-content:space-between;align-items:start;gap:20px}.gg-heading h2{font-size:clamp(1.65rem,3vw,2.2rem);margin:0 0 5px}.gg-heading p:not(.g6-overline){margin:0;color:#5e7283}.gg-library{white-space:nowrap;background:#e5f7ee;color:#247447;border-radius:100px;padding:9px 14px;font-weight:800}.gg-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:28px}.gg-fields fieldset{border:1px solid #dfe8ef;border-radius:16px;padding:16px;min-width:0}.gg-fields legend{font-size:1.05rem;font-weight:800;padding:0 7px;color:#153e5a}.gg-segments{display:flex;gap:7px;flex-wrap:wrap}.gg-segments label{cursor:pointer}.gg-segments input{position:absolute;opacity:0;width:1px;height:1px}.gg-segments span{display:inline-flex;background:#f4f8fb;border:1px solid #d7e4ec;border-radius:10px;padding:10px 12px;font-weight:800;color:#395a6d;min-height:44px;align-items:center}.gg-segments input:checked+span{color:white;background:#176d8a;border-color:#176d8a}.gg-segments input:focus-visible+span{outline:3px solid #93dce7;outline-offset:2px}#unit-select{display:block;width:100%;margin-top:12px;border:1px solid #cbdce8;border-radius:10px;padding:10px;background:#fff;color:#21465e}#unit-select:disabled{opacity:.5}.gg-field-note{color:#65798a;line-height:1.5;font-size:.86rem;margin:11px 0 0}.gg-start-row{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:26px;border-top:1px solid #e4edf2;padding-top:23px}.gg-start-row p{color:#526d7e;margin:0}.gg-primary,.gg-secondary{border-radius:12px;font-weight:800;padding:12px 18px}.gg-primary{border:0;background:#176d8a;color:#fff;box-shadow:0 5px 13px #176d8a29}.gg-primary:hover{background:#0d5672}.gg-secondary{border:1px solid #afd3df;background:#eaf7fa;color:#0f6578}.gg-secondary:hover{background:#d9f0f5}.gg-primary:disabled,.gg-secondary:disabled{opacity:.5;cursor:default}.gg-play{max-width:820px;margin:28px auto}.gg-play-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap;color:#3c647b;font-weight:800;margin-bottom:13px}.gg-play-top span:nth-child(2){margin-right:auto}#sound-toggle{border:1px solid #d5e4ec;background:#fff;border-radius:100px;padding:8px 13px;font-weight:800;color:#2b617a}.gg-progress-track{height:10px;background:#dbeaf1;border-radius:100px;overflow:hidden;margin-bottom:18px}.gg-progress-track span{display:block;height:100%;width:0;background:linear-gradient(90deg,#23a5b4,#78cc96);transition:width .35s}.gg-question-card{background:#fff;border:1px solid #dfe9ef;border-radius:22px;box-shadow:0 10px 30px #12344c16;padding:30px;position:relative;overflow:hidden}.gg-question-meta{display:flex;flex-wrap:wrap;gap:8px}.gg-question-meta span{background:#edf6fa;color:#16657c;border-radius:100px;padding:6px 11px;font-size:.78rem;font-weight:800}.gg-rule{font-size:.9rem;color:#687d8b;background:#f4f8fa;border-left:4px solid #67b9c8;padding:12px 14px;border-radius:7px;margin:19px 0}.gg-question-card h2{font-size:clamp(1.45rem,3vw,2rem);line-height:1.4;margin:0 0 22px}.gg-options{display:grid;grid-template-columns:1fr 1fr;gap:10px}.gg-option{padding:15px;border:1px solid #d3e2e9;border-radius:13px;background:#f7fafc;text-align:left;color:#21485c;font-weight:800}.gg-option:hover:not(:disabled){background:#eaf7fa;border-color:#70bccb}.gg-option:disabled{cursor:default}.gg-option.is-correct{background:#e2f7e9;border-color:#62bf83;color:#167443}.gg-option.is-wrong{background:#feebeb;border-color:#e58c93;color:#a8323c}.gg-input-row{display:flex;flex-wrap:wrap;gap:9px}.gg-input-row input{flex:1;min-width:200px;border:1px solid #bed2dd;border-radius:11px;padding:11px 14px}.gg-input-row input:focus{outline:3px solid #a2e0e8}.gg-tokens,.gg-built{display:flex;flex-wrap:wrap;gap:8px;min-height:60px;align-items:center}.gg-tokens button{border:1px solid #a9d4dd;background:#eaf8fa;border-radius:10px;padding:11px 15px;color:#155f74;font-weight:800}.gg-tokens button:disabled{opacity:.35}.gg-built{padding:10px 13px;border:2px dashed #b5ceda;border-radius:12px;margin:12px 0;color:#496d81}.gg-built button{border:0;background:#dbedf3;border-radius:8px;padding:7px 11px;color:#205569;font-weight:800}.gg-token-actions{display:flex;gap:9px;flex-wrap:wrap}.gg-feedback{min-height:28px;margin:20px 0 8px;font-weight:800;line-height:1.55}.gg-feedback small{display:block;font-size:.92rem;font-weight:600;margin-top:5px}.gg-feedback.good{color:#167245}.gg-feedback.bad{color:#ac3545}.gg-answer-actions{display:flex;gap:10px;flex-wrap:wrap}.gg-answer-actions [hidden]{display:none}.gg-question-card.gg-good{animation:gg-pop .5s ease;border-color:#67c993}.gg-question-card.gg-bad{animation:gg-shake .43s ease;border-color:#dc8d99}.gg-celebration{position:fixed;inset:0;pointer-events:none;z-index:50;overflow:hidden}.gg-celebration span{position:absolute;left:var(--left);top:28%;font-size:var(--size);animation:gg-fly 1s ease-out forwards}.gg-result{text-align:center;max-width:820px;margin:30px auto}.gg-result-icon{font-size:4rem;animation:gg-pop .7s ease}.gg-result h2{font-size:2.2rem;margin:5px 0}.gg-result>p:not(.g6-overline){color:#597182}.gg-result-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:27px 0}.gg-result-stats div{background:#f0f8fb;border-radius:13px;padding:16px 8px}.gg-result-stats strong{font-size:1.45rem;color:#176d8a;display:block}.gg-result-stats span{font-size:.82rem;color:#577080}.gg-result-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}.gg-info{margin:30px 0 22px;box-shadow:none;background:#f7fafc}.gg-info h2{margin:0 0 8px}.gg-info p{color:#5c7182;line-height:1.6;margin:0 0 11px}.gg-info a{color:#176d8a;font-weight:800}@keyframes gg-pop{50%{transform:scale(1.03)}}@keyframes gg-shake{20%,60%{transform:translateX(-6px)}40%,80%{transform:translateX(6px)}}@keyframes gg-fly{to{top:88%;left:calc(var(--left) + var(--drift));transform:rotate(250deg);opacity:0}}@media(max-width:760px){.gg-fields{grid-template-columns:1fr}.gg-stats{grid-template-columns:repeat(2,1fr)}.gg-hero-badge{display:none}.gg-options{grid-template-columns:1fr}.gg-result-stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:540px){.gg-hero{padding-bottom:58px}.gg-stats{margin-top:-30px}.gg-setup,.gg-result,.gg-question-card,.gg-info{padding:19px}.gg-heading,.gg-start-row{align-items:start;flex-direction:column}.gg-library{font-size:.86rem}.gg-start-row .gg-primary{width:100%}.gg-play-top span:nth-child(2){width:100%}.gg-play-top #sound-toggle{margin-left:auto}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}.gg-celebration{display:none}}
.g6-grammar-link{display:inline-flex;text-decoration:none;margin-top:12px}
.gg-hint[hidden]{display:none}.gg-hint{background:#fff8df;border:1px solid #efcf79;border-radius:14px;padding:14px 17px;margin:-5px 0 17px;color:#674d14;animation:gg-pop .3s ease}.gg-hint strong{display:block;margin-bottom:5px}.gg-hint p{margin:6px 0;line-height:1.5}.gg-answer-actions #reveal[hidden]{display:none}

.gg-rewrite-source,.gg-rewrite-cue{padding:13px 16px;border-radius:13px;margin-bottom:12px}.gg-rewrite-source{background:#f2f8fc;border:1px solid #d9e9f2}.gg-rewrite-cue{background:#fff8e9;border:1px solid #edd8a7}.gg-rewrite-source strong,.gg-rewrite-cue strong{font-size:.85rem;color:#355d70}.gg-rewrite-source p,.gg-rewrite-cue p{font-size:1.08rem;font-weight:800;margin:5px 0 0;color:#203f56;line-height:1.5}.gg-rewrite-form{display:flex;flex-direction:column;gap:9px}.gg-rewrite-form label{font-weight:800;color:#27526b}.gg-rewrite-form textarea{width:100%;resize:vertical;border:1px solid #bed2dd;border-radius:11px;padding:12px 14px;font:inherit;color:#203f56;line-height:1.5}.gg-rewrite-form textarea:focus{outline:3px solid #a2e0e8}.gg-rewrite-form small{color:#667d8e;line-height:1.45}.gg-rewrite-form button{align-self:flex-start}

/* Giao diá»‡n há»c trÃªn Ä‘iá»‡n thoáº¡i: nÃºt báº¯t Ä‘áº§u luÃ´n tháº¥y, cÃ¢u há»i dÃ¹ng trá»n mÃ n hÃ¬nh. */
.gg-result-stats{grid-template-columns:repeat(2,minmax(0,1fr));max-width:470px;margin-left:auto;margin-right:auto}
@media(max-width:760px){
  .gg-is-setup .gg-setup{padding-bottom:102px}
  .gg-is-setup .gg-start-row .gg-primary{position:fixed;z-index:40;left:16px;right:16px;bottom:calc(12px + env(safe-area-inset-bottom));width:calc(100% - 32px);min-height:56px;font-size:1.08rem;box-shadow:0 7px 22px #17496255}
  .gg-is-playing{height:100dvh;overflow:hidden}
  .gg-is-playing .gg-hero,.gg-is-playing .gg-stats,.gg-is-playing .gg-setup,.gg-is-playing .gg-info,.gg-is-playing .g6-source,.gg-is-playing contact-danh{display:none!important}
  .gg-is-playing .gg-main{width:100%;max-width:none;margin:0;padding:0}
  .gg-is-playing .gg-play{position:fixed;inset:0;z-index:45;display:flex;flex-direction:column;box-sizing:border-box;width:100%;max-width:none;height:100vh;height:100dvh;margin:0;padding:calc(7px + env(safe-area-inset-top)) 10px calc(8px + env(safe-area-inset-bottom));background:#eef7f8}
  .gg-is-playing .gg-play-top{flex:none;min-height:34px;gap:7px;margin-bottom:5px;font-size:.88rem}
  .gg-is-playing .gg-play-top span:nth-child(2){width:auto;margin-right:auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:48%}
  .gg-is-playing #sound-toggle{margin-left:0;padding:6px 9px;font-size:.78rem;white-space:nowrap}
  .gg-is-playing .gg-progress-track{flex:none;height:6px;margin-bottom:7px}
  .gg-is-playing .gg-question-card{flex:1;min-height:0;display:flex;flex-direction:column;padding:16px;border-radius:15px;overflow-y:auto;overscroll-behavior:contain}
  .gg-is-playing .gg-question-meta{flex:none;gap:5px}
  .gg-is-playing .gg-question-meta span{padding:5px 9px;font-size:.8125rem}
  .gg-is-playing .gg-question-card h2{flex:none;font-size:clamp(1.5rem,6.2vw,1.75rem);line-height:1.45;margin:12px 0 18px;overflow-wrap:anywhere}
  .gg-is-playing #answer-area{flex:none;min-width:0;overflow-wrap:anywhere}
  .gg-is-playing .gg-hint{flex:none;margin:0 0 14px;padding:12px;font-size:1rem;line-height:1.5}
  .gg-is-playing .gg-hint p{margin:3px 0}
  .gg-is-playing .gg-option{min-height:52px;padding:12px 14px;font-size:1.125rem;line-height:1.5;overflow-wrap:anywhere}
  .gg-is-playing .gg-options{gap:10px}
  .gg-is-playing .gg-rewrite-source,.gg-is-playing .gg-rewrite-cue{padding:12px;margin-bottom:12px;border-radius:9px}
  .gg-is-playing .gg-rewrite-source strong,.gg-is-playing .gg-rewrite-cue strong{font-size:.9375rem}
  .gg-is-playing .gg-rewrite-source p,.gg-is-playing .gg-rewrite-cue p{font-size:1.25rem;line-height:1.5;margin:6px 0 0}
  .gg-is-playing .gg-rewrite-form{gap:6px}
  .gg-is-playing .gg-rewrite-form label{font-size:1rem}
  .gg-is-playing .gg-rewrite-form textarea{min-height:110px;padding:12px;font-size:1.125rem}
  .gg-is-playing .gg-rewrite-form small{display:none}
  .gg-is-playing .gg-input-row{flex-direction:column}
  .gg-is-playing .gg-input-row input{min-width:0;width:100%;font-size:1.125rem}
  .gg-is-playing .gg-input-row .gg-primary,.gg-is-playing .gg-rewrite-form .gg-primary,.gg-is-playing .gg-token-actions .gg-primary{width:100%;min-height:48px;font-size:1rem}
  .gg-is-playing .gg-tokens,.gg-is-playing .gg-built{min-height:0;gap:5px}
  .gg-is-playing .gg-tokens button{padding:10px 12px;min-height:48px;font-size:1.125rem;line-height:1.5;overflow-wrap:anywhere}
  .gg-is-playing .gg-built{margin:12px 0;padding:10px;font-size:1.125rem}
  .gg-is-playing .gg-built button{min-height:44px;font-size:1.125rem;line-height:1.5;overflow-wrap:anywhere}
  .gg-is-playing .gg-feedback{flex:none;min-height:0;margin:14px 0 10px;font-size:1.0625rem;line-height:1.5}
  .gg-is-playing .gg-feedback:empty{display:none}
  .gg-is-playing .gg-feedback small{font-size:1rem;margin-top:6px}
  .gg-is-playing .gg-answer-actions{flex:none;gap:6px}
  .gg-is-playing .gg-answer-actions button{flex:1;min-height:44px;padding:8px 10px}
}
@media(max-width:760px) and (max-height:620px){
  .gg-is-playing .gg-play{padding-top:4px;padding-bottom:4px}
  .gg-is-playing .gg-question-card{padding:9px}
  .gg-is-playing .gg-question-card h2{margin:8px 0 12px}
}

#exit-play{border:1px solid #d5e4ec;background:#fff;border-radius:100px;padding:8px 13px;font-weight:800;color:#2b617a;white-space:nowrap}
#motion-toggle{border:1px solid #d5e4ec;background:#fff;border-radius:100px;padding:8px 13px;font-weight:800;color:#2b617a;min-height:44px}
.gg-exam-answer{display:flex;flex-direction:column;gap:8px;font-size:1.25rem;line-height:1.5}
.gg-exam-answer>span{font-weight:800;color:#21485c}
.gg-passage{background:#f0f8fc;border:1px solid #d4e8ef;border-radius:14px;padding:16px;margin-bottom:16px;line-height:1.65;font-size:1.2rem}
.gg-passage p{margin:8px 0 0}
.gg-option{font-size:1.125rem;min-height:48px}
.gg-option u{text-decoration-thickness:2px;text-underline-offset:4px}
.gg-reduce-motion *,.gg-reduce-motion *::before,.gg-reduce-motion *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
.gg-reduce-motion .gg-celebration{display:none}
@media(max-width:760px){.gg-is-playing .gg-play{top:var(--gg-profile-height,0px);height:calc(100dvh - var(--gg-profile-height,0px))}.gg-is-playing #motion-toggle{font-size:.78rem;padding:6px 9px;min-height:44px}.gg-exam-answer>span{overflow-wrap:anywhere}.gg-is-playing .gg-passage{font-size:1.125rem;padding:12px}.gg-is-playing .gg-play-top{flex-wrap:wrap}.gg-is-playing #sound-toggle{min-height:44px}}
@media(max-width:760px){.gg-is-playing .gg-play-top span:nth-child(2){display:none}.gg-is-playing #exit-play{padding:6px 9px;font-size:.78rem;margin-left:auto}}
@import url('../../../../shared/learner-font.css');
.g6-picture-audio{display:inline-grid;place-items:center;width:120px;height:120px;padding:4px;border:2px solid #b7c3a7;border-radius:43% 48% 45% 46%;background:#fffaf0;color:inherit;font-family:"Danh Nunito",sans-serif;font-size:3.5rem;cursor:pointer;flex:none}
.g6-picture-audio img{width:100%;height:100%;object-fit:contain;pointer-events:none;border-radius:inherit}
.g6-picture-audio:focus-visible{outline:3px solid #176d8a;outline-offset:4px}
.g6-word-grid{grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}
.g6-word-card{padding:14px;min-width:0;overflow-wrap:anywhere}
.g6-word-card h3{margin:7px 0 2px}.g6-example{margin:6px 0 0}
.g6-lesson-main{padding-top:16px}.g6-tabs{margin-bottom:16px}
.g6-stage:has(>.g6-picture-audio){padding:16px}
.g6-stage>.g6-picture-audio{display:grid;margin:10px auto}
.g6-flashcard.g6-picture-flash{min-height:280px;padding:18px;gap:10px}
.g6-picture-flash .g6-flip-action{border:0;background:transparent;color:inherit;min-height:44px;padding:10px;font:inherit;cursor:pointer;max-width:100%;overflow-wrap:anywhere}
.g6-picture-flash .g6-flip-action strong{display:block}.g6-picture-flash .g6-flip-action span{display:block;font-size:16px}
.g6-feedback:empty,#speech-note:empty{display:none}
@media(max-width:570px){.g6-word-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.g6-word-card{padding:10px}.g6-picture-audio{width:96px;height:96px;font-size:3rem}.g6-word-card h3{font-size:20px;line-height:1.25}.g6-word-card .g6-meaning{font-size:16px}.g6-word-card .g6-example{font-size:15px;line-height:1.4}.g6-lesson-hero{padding-bottom:22px}.g6-lesson-hero-inner{margin-top:16px}.g6-stage h3{margin:10px 0 14px}}
